{# Dealer Hedge (demo) tab (/view/dealer_hedge): a static teaching page, rendered by app/dealer_hedge.py with
   autoescape on. No data, no fetch, no external request: fonts are system fonts and every number comes from the
   Black-Scholes code in the script below. The only value from the renderer is `source`. #}
<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Dealer Hedge (demo)</title>
<link rel="icon" href="/static/icons/icon-192.png">
<style>
/* Layout: a trading-desk "blotter" — one narrow reading column for theory, a wide instrument panel for the live book. */
:root{
  --bg:#f3f1ec; --panel:#ffffff; --fg:#1c1b19; --muted:#6b675f; --line:#d9d4ca;
  --accent:#0f6e8c;            /* dealer / hedge actions */
  --buy:#1f8a4c; --sell:#c0392b; /* flow direction */
  --gamma:#d97b1a; --vanna:#7a4bb8; --charm:#0f6e8c; --vega:#b8266b;
  --soft:#e9e5dc;
  --display:Georgia,"Times New Roman",serif; --body:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif; --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ --bg:#05111F; --panel:#1d2024; --fg:#ebe7df; --muted:#a39d92; --line:#343840; --accent:#5fb8d6; --buy:#4fc07a; --sell:#e8604f; --gamma:#f0a04b; --vanna:#b08ae6; --charm:#5fb8d6; --vega:#e86aa0; --soft:#262a30; color-scheme:dark } }
:root[data-theme="dark"]{ --bg:#05111F; --panel:#1d2024; --fg:#ebe7df; --muted:#a39d92; --line:#343840; --accent:#5fb8d6; --buy:#4fc07a; --sell:#e8604f; --gamma:#f0a04b; --vanna:#b08ae6; --charm:#5fb8d6; --vega:#e86aa0; --soft:#262a30; color-scheme:dark }

*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--body);line-height:1.55;padding-inline:16px;padding-block:28px 60px;}
.wrap{max-width:1080px;margin:0 auto;display:grid;gap:40px}
h1{font-family:var(--display);font-size:clamp(30px,5vw,46px);line-height:1.05;margin:0 0 10px;text-wrap:balance;font-weight:700}
h2{font-family:var(--display);font-size:clamp(22px,3vw,30px);margin:0 0 14px;line-height:1.15;text-wrap:balance;font-weight:600}
h3{font-size:16px;margin:0 0 6px;font-weight:600}
p{margin:0 0 12px;max-width:68ch}
.lead{font-size:18px;color:var(--muted);max-width:62ch}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:18px;min-width:0}
.tag{display:inline-block;font-family:var(--mono);font-size:11px;padding:2px 8px;border-radius:999px;border:1px solid var(--line);color:var(--muted)}
.k{font-family:var(--mono)}
.g-gamma{color:var(--gamma)} .g-vanna{color:var(--vanna)} .g-charm{color:var(--charm)} .g-vega{color:var(--vega)}
.buy{color:var(--buy);font-weight:600} .sell{color:var(--sell);font-weight:600}
svg text{font-family:var(--body)}
.diagram{width:100%;overflow-x:auto}
.diagram svg{display:block;min-width:640px;max-width:100%;height:auto}

/* Instrument panel */
.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px;display:grid;gap:18px}
.controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px 22px}
.ctrl label{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-bottom:4px}
.ctrl label b{color:var(--fg);font-family:var(--mono);font-weight:500}
.ctrl input[type=range]{width:100%;accent-color:var(--accent)}
.ctrl select{width:100%;padding:8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg);font:inherit}
.presets{display:flex;flex-wrap:wrap;gap:8px}
.presets button, .btn{font:inherit;font-size:13px;padding:7px 12px;border:1px solid var(--line);border-radius:999px;background:var(--bg);color:var(--fg);cursor:pointer}
.presets button[aria-pressed=true]{background:var(--accent);color:#fff;border-color:var(--accent)}
.presets button:focus-visible,.btn:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.readout{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.tile{background:var(--bg);border-radius:8px;padding:12px 14px;min-width:0}
.tile .lbl{font-size:12px;color:var(--muted)}
.tile .val{font-family:var(--mono);font-size:22px;font-variant-numeric:tabular-nums;margin-top:2px}
.tile .sub{font-size:12px;color:var(--muted);margin-top:2px}
.verdict{border-left:4px solid var(--accent);background:var(--bg);padding:12px 16px;border-radius:0 8px 8px 0;font-size:15px}
.verdict strong{font-size:17px}
.decomp{display:grid;gap:6px;font-family:var(--mono);font-size:13px;font-variant-numeric:tabular-nums}
.decomp div{display:grid;grid-template-columns:90px 1fr 110px;gap:10px;align-items:center}
.bar{height:10px;background:var(--soft);border-radius:4px;position:relative;overflow:hidden}
.bar i{position:absolute;top:0;bottom:0;border-radius:4px}
.charts{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px}
.chart{min-width:0}
.chart canvas{width:100%;height:auto;display:block;border:1px solid var(--line);border-radius:8px;background:var(--bg)}
.chart .cap{font-size:12px;color:var(--muted);margin-top:6px}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
.legend span::before{content:"";display:inline-block;width:12px;height:3px;margin-right:6px;vertical-align:middle;background:currentColor}

/* Scenarios */
.scen{display:grid;gap:10px}
.scen details{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:0}
.scen summary{cursor:pointer;padding:14px 18px;font-weight:600;list-style:none;display:flex;gap:10px;align-items:center}
.scen summary::before{content:"+";font-family:var(--mono);color:var(--accent);width:14px}
.scen details[open] summary::before{content:"–"}
.scen .body{padding:0 18px 16px;display:grid;gap:8px}
.steps{display:grid;gap:6px;counter-reset:s}
.steps div{display:grid;grid-template-columns:26px 1fr;gap:8px;align-items:start;font-size:14px}
.steps div::before{counter-increment:s;content:counter(s);font-family:var(--mono);font-size:12px;color:#fff;background:var(--accent);border-radius:50%;width:22px;height:22px;display:grid;place-items:center;margin-top:2px}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:600}
.tablewrap{overflow-x:auto}
.res{list-style:none;padding:0;margin:0;display:grid;gap:10px;font-size:14px}
.res li{padding-left:14px;border-left:2px solid var(--line)}
.res a{color:var(--accent);font-weight:600;text-decoration:none}
.res a:hover,.res a:focus-visible{text-decoration:underline}
.foot{font-size:13px;color:var(--muted);border-top:1px solid var(--line);padding-top:14px}
@media (prefers-reduced-motion:no-preference){ .flowdot{animation:dash 2.4s linear infinite} @keyframes dash{to{stroke-dashoffset:-40}} }
</style>
</head>
<body>

<div class="wrap">

<header>
  <div class="eyebrow">Opsiyon Greek'leri · Dealer akışları · Türkçe anlatım</div>
  <h1>Piyasa yapıcı nasıl hedge eder, Gamma, Vanna ve Charm bu hedge'i nasıl hareket ettirir?</h1>
  <p class="lead">Bu sayfa üç videonun anlattığı mekaniği tek bir döngüde birleştirir: müşteri opsiyon alır veya satar, dealer karşı tarafı üstlenir, dayanak varlıkla delta hedge yapar, sonra fiyat, zaman ve oynaklık bu delta'yı değiştirdikçe hedge'ini yeniler. Piyasayı iten "gizli akış" bu yenilemedir.</p>
</header>

<!-- 1. Core loop -->
<section>
  <h2>1. Döngü: her şey dealer'ın delta nötr kalma zorunluluğundan çıkar</h2>
  <p>Dealer (market maker) yön üzerine bahis oynamaz. Sattığı veya aldığı her opsiyonun delta'sını dayanak varlıkla sıfırlar. Ama delta sabit durmaz. Üç kuvvet onu sürekli değiştirir ve dealer her seferinde hisse alıp satarak sıfıra geri döner. Fiyatı iten şey, bu zorunlu alım satımdır.</p>
  <div class="diagram card"><svg viewBox="0 0 900 420" role="img" aria-label="Dealer hedge döngüsü">
    <defs><marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="var(--accent)"/></marker></defs>
    <!-- boxes -->
    <g font-size="13">
      <rect x="20" y="40" width="200" height="70" rx="10" fill="var(--soft)" stroke="var(--line)"/>
      <text x="120" y="68" text-anchor="middle" font-weight="600" fill="var(--fg)">Müşteriler</text>
      <text x="120" y="88" text-anchor="middle" fill="var(--muted)">put alır, call satar (koruma)</text>

      <rect x="350" y="40" width="200" height="70" rx="10" fill="var(--accent)" />
      <text x="450" y="68" text-anchor="middle" font-weight="600" fill="#fff">Dealer defteri</text>
      <text x="450" y="88" text-anchor="middle" fill="#fff" opacity=".9">short put · long call</text>

      <rect x="680" y="40" width="200" height="70" rx="10" fill="var(--soft)" stroke="var(--line)"/>
      <text x="780" y="68" text-anchor="middle" font-weight="600" fill="var(--fg)">Delta hedge</text>
      <text x="780" y="88" text-anchor="middle" fill="var(--muted)">dayanak varlık al / sat</text>

      <rect x="680" y="300" width="200" height="70" rx="10" fill="var(--soft)" stroke="var(--line)"/>
      <text x="780" y="328" text-anchor="middle" font-weight="600" fill="var(--fg)">Fiyat hareket eder</text>
      <text x="780" y="348" text-anchor="middle" fill="var(--muted)">hedge akışı piyasayı iter</text>

      <rect x="20" y="300" width="200" height="70" rx="10" fill="var(--soft)" stroke="var(--line)"/>
      <text x="120" y="328" text-anchor="middle" font-weight="600" fill="var(--fg)">Delta değişir</text>
      <text x="120" y="348" text-anchor="middle" fill="var(--muted)">yeniden hedge gerekir</text>

      <!-- the three forces -->
      <rect x="300" y="200" width="300" height="110" rx="10" fill="var(--panel)" stroke="var(--line)"/>
      <text x="450" y="222" text-anchor="middle" font-size="11" letter-spacing="1.5" fill="var(--muted)">DELTA'YI DEĞİŞTİREN ÜÇ KUVVET</text>
      <text x="330" y="250" fill="var(--gamma)" font-weight="600">Gamma</text><text x="400" y="250" fill="var(--fg)">fiyat değişince</text>
      <text x="330" y="272" fill="var(--charm)" font-weight="600">Charm</text><text x="400" y="272" fill="var(--fg)">zaman geçince</text>
      <text x="330" y="294" fill="var(--vanna)" font-weight="600">Vanna</text><text x="400" y="294" fill="var(--fg)">zımni oynaklık (IV) değişince</text>
    </g>
    <!-- arrows -->
    <g fill="none" stroke="var(--accent)" stroke-width="2.5" marker-end="url(#arr)">
      <path d="M220,75 L348,75"/>
      <path d="M550,75 L678,75"/>
      <path d="M780,112 L780,298"/>
      <path d="M678,335 L222,335"/>
      <path d="M120,298 L120,112"/>
    </g>
    <g fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 6" class="flowdot" opacity=".8" marker-end="url(#arr)">
      <path d="M560,255 L690,255 L690,300"/>
      <path d="M300,255 L190,255 L190,300"/>
    </g>
    <g font-size="12" fill="var(--muted)">
      <text x="284" y="65" text-anchor="middle">opsiyon</text>
      <text x="614" y="65" text-anchor="middle">delta → 0</text>
      <text x="450" y="355" text-anchor="middle">fiyat, IV, zaman değişti</text>
      <text x="840" y="200" text-anchor="middle">zorunlu akış</text>
    </g>
  </svg></div>
  <div class="grid2" style="margin-top:14px">
    <div class="card"><h3>Dealer neden short put, long call?</h3><p>Endekslerde yatırımcılar düşüşe karşı put alır ve getiri için call satar (covered call, overwriting). Dealer bunun karşı tarafıdır: put'ta short, call'da long. Bu yüzden put'ların IV'si call'lardan yüksektir. Bu farka <b>skew</b> denir.</p></div>
    <div class="card"><h3>Bu defterin delta'sı pozitiftir</h3><p>Short put delta'sı pozitif, long call delta'sı pozitiftir. Dealer net <b>long delta</b> taşır ve nötr kalmak için <b>hisse açığa satar</b>. Bu açık pozisyon, aşağıdaki her kuvvetin "geri alım" baskısına dönüşmesinin sebebidir.</p></div>
  </div>
</section>

<!-- 2. Live book -->
<section>
  <h2>2. Canlı defter: kaydırıcıları oynatın, dealer'ın ne yapmak zorunda kaldığını izleyin</h2>
  <p>Aşağıdaki hesaplar Black-Scholes ile yapılır. Defter 100'er kontratlık basit pozisyonlardan oluşur (1 kontrat = 100 hisse). Başlangıç noktası: dayanak 100, IV %20, vadeye 20 gün. Kaydırıcıyı oynattığınızda dealer'ın delta'sı değişir ve sayfa, nötre dönmek için kaç hisse <span class="buy">alması</span> veya <span class="sell">satması</span> gerektiğini gösterir.</p>
  <div class="panel">
    <div>
      <div class="eyebrow">Defter ön ayarı</div>
      <div class="presets" id="presets">
        <button data-p="index" aria-pressed="true">Tipik endeks defteri (short put 95, long call 105)</button>
        <button data-p="shortgamma">Dealer opsiyon satmış (short straddle 100)</button>
        <button data-p="longgamma">Dealer opsiyon almış (long straddle 100)</button>
        <button data-p="pin">Tek büyük strike (long call 100, pinning)</button>
      </div>
    </div>
    <div class="controls">
      <div class="ctrl"><label for="spot">Dayanak fiyat <b id="spotV">100.0</b></label><input type="range" id="spot" min="85" max="115" step="0.25" value="100"></div>
      <div class="ctrl"><label for="iv">Zımni oynaklık (IV) <b id="ivV">20%</b></label><input type="range" id="iv" min="8" max="60" step="0.5" value="20"></div>
      <div class="ctrl"><label for="dte">Vadeye kalan gün <b id="dteV">20</b></label><input type="range" id="dte" min="0.25" max="60" step="0.25" value="20"></div>
      <div class="ctrl"><label for="base">&nbsp;</label><button class="btn" id="reset">Başlangıca dön (100 / %20 / 20 gün)</button></div>
    </div>

    <div class="verdict" id="verdict">Dealer başlangıçta delta nötr. Bir kaydırıcıyı oynatın.</div>

    <div class="readout">
      <div class="tile"><div class="lbl">Defterin opsiyon delta'sı</div><div class="val" id="bookDelta">0</div><div class="sub">hisse eşdeğeri</div></div>
      <div class="tile"><div class="lbl">Dealer'ın hisse hedge'i</div><div class="val" id="hedge">0</div><div class="sub">başlangıçta (− = açığa satış)</div></div>
      <div class="tile"><div class="lbl">Gereken ek işlem</div><div class="val" id="trade">0</div><div class="sub">şimdi nötre dönmek için</div></div>
      <div class="tile"><div class="lbl">Defter Gamma'sı</div><div class="val" id="bookGamma">0</div><div class="sub">hisse / 1 puan fiyat</div></div>
      <div class="tile"><div class="lbl">Defter Vanna'sı</div><div class="val" id="bookVanna">0</div><div class="sub">hisse / +1 puan IV</div></div>
      <div class="tile"><div class="lbl">Defter Charm'ı</div><div class="val" id="bookCharm">0</div><div class="sub">hisse / 1 gün</div></div>
      <div class="tile"><div class="lbl">Defter Vega'sı</div><div class="val" id="bookVega">0</div><div class="sub">$ P/L / +1 puan IV</div></div>
    </div>

    <div>
      <div class="eyebrow">Ek işlemin kaynağı (yaklaşık ayrıştırma)</div>
      <div class="decomp" id="decomp"></div>
    </div>

    <div class="charts">
      <div class="chart"><canvas id="c1" width="640" height="360"></canvas><div class="cap">Dealer'ın gereken hisse hedge'i, dayanak fiyata göre. Eğrinin eğimi Gamma'dır. Dikey çizgi şu anki fiyat. Soluk eğri: başlangıç durumu.</div></div>
      <div class="chart"><canvas id="c2" width="640" height="360"></canvas><div class="cap">Her kuvvetin dayanak fiyata göre profili: pozitif değer dealer'ın <b>almak</b> zorunda kaldığı akış (fiyat 1 puan yukarı, IV 1 puan aşağı, 1 gün geçince).</div><div class="legend"><span class="g-gamma">Gamma akışı</span><span class="g-vanna">Vanna akışı (IV −1)</span><span class="g-charm">Charm akışı (1 gün)</span></div></div>
    </div>
  </div>
</section>

<!-- 3. Greek map -->
<section>
  <h2>3. Greek'lerin birbirine bağlantısı</h2>
  <p>Birinci dereceden Greek'ler opsiyon fiyatının neye duyarlı olduğunu söyler. İkinci dereceden Greek'ler ise <b>Delta'nın</b> neye duyarlı olduğunu söyler. Dealer'ı ilgilendiren hep Delta'dır, çünkü hedge'i Delta'ya göre yapar.</p>
  <div class="diagram card"><svg viewBox="0 0 900 360" role="img" aria-label="Greek bağlantı haritası">
    <defs><marker id="arr2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--muted)"/></marker></defs>
    <g font-size="13">
      <!-- inputs -->
      <rect x="30" y="40" width="150" height="54" rx="8" fill="var(--soft)" stroke="var(--line)"/><text x="105" y="72" text-anchor="middle" font-weight="600" fill="var(--fg)">Dayanak fiyat</text>
      <rect x="30" y="150" width="150" height="54" rx="8" fill="var(--soft)" stroke="var(--line)"/><text x="105" y="182" text-anchor="middle" font-weight="600" fill="var(--fg)">Zaman</text>
      <rect x="30" y="260" width="150" height="54" rx="8" fill="var(--soft)" stroke="var(--line)"/><text x="105" y="292" text-anchor="middle" font-weight="600" fill="var(--fg)">Zımni oynaklık</text>
      <!-- delta -->
      <rect x="390" y="130" width="150" height="80" rx="8" fill="var(--accent)"/><text x="465" y="165" text-anchor="middle" font-weight="700" fill="#fff" font-size="16">Delta</text><text x="465" y="186" text-anchor="middle" fill="#fff" opacity=".9" font-size="12">hedge edilen şey</text>
      <!-- price -->
      <rect x="720" y="40" width="150" height="54" rx="8" fill="var(--soft)" stroke="var(--line)"/><text x="795" y="72" text-anchor="middle" font-weight="600" fill="var(--fg)">Opsiyon fiyatı</text>
      <!-- hedge -->
      <rect x="720" y="150" width="150" height="54" rx="8" fill="var(--panel)" stroke="var(--accent)" stroke-width="2"/><text x="795" y="182" text-anchor="middle" font-weight="600" fill="var(--fg)">Hisse hedge'i</text>
      <rect x="720" y="260" width="150" height="54" rx="8" fill="var(--soft)" stroke="var(--line)"/><text x="795" y="292" text-anchor="middle" font-weight="600" fill="var(--fg)">Dealer P/L</text>
    </g>
    <g fill="none" stroke-width="2.5" marker-end="url(#arr2)">
      <path d="M180,67 C300,67 300,160 388,160" stroke="var(--gamma)"/>
      <path d="M180,177 L388,177" stroke="var(--charm)"/>
      <path d="M180,287 C300,287 300,195 388,195" stroke="var(--vanna)"/>
      <path d="M540,170 L718,177" stroke="var(--accent)"/>
      <path d="M180,287 C450,330 600,330 718,290" stroke="var(--vega)"/>
      <path d="M180,55 C450,10 600,10 718,55" stroke="var(--muted)"/>
    </g>
    <g font-size="12" font-weight="600">
      <text x="285" y="100" fill="var(--gamma)">Gamma</text>
      <text x="285" y="170" fill="var(--charm)">Charm</text>
      <text x="285" y="245" fill="var(--vanna)">Vanna</text>
      <text x="450" y="340" fill="var(--vega)">Vega (fiyat → IV duyarlılığı)</text>
      <text x="450" y="22" fill="var(--muted)">Delta (birinci derece)</text>
      <text x="610" y="160" fill="var(--accent)">hedge = −Delta</text>
    </g>
  </svg></div>
  <div class="tablewrap card" style="margin-top:14px">
    <table>
      <thead><tr><th>Greek</th><th>Neyi ölçer</th><th>Uzun opsiyonda işaret (call veya put fark etmez)</th><th>En güçlü olduğu yer</th><th>Dealer için anlamı</th></tr></thead>
      <tbody>
        <tr><td class="g-gamma"><b>Gamma</b></td><td>Fiyat → Delta</td><td>Her zaman pozitif</td><td>Strike'ta, kısa vadede</td><td>Long gamma: harekete karşı işlem (sakinleştirir). Short gamma: hareketle aynı yönde (büyütür).</td></tr>
        <tr><td class="g-charm"><b>Charm</b></td><td>Zaman → Delta</td><td>Strike üstünde +, altında −, strike'ta ≈ 0</td><td>Strike çevresinde, son günlerde</td><td>Long opsiyon: strike altında destekleyici, üstünde bastırıcı. Short opsiyonda tersi.</td></tr>
        <tr><td class="g-vanna"><b>Vanna</b></td><td>IV → Delta</td><td>Strike üstünde −, altında +, strike'ta ≈ 0</td><td>Tüm vadelerde, moneyness kayar</td><td>IV düşünce OTM opsiyonların delta'sı erir, dealer hedge'ini geri alır.</td></tr>
        <tr><td class="g-vega"><b>Vega</b></td><td>IV → Opsiyon fiyatı</td><td>Her zaman pozitif</td><td>ATM, uzun vadede</td><td>Dealer genelde short vega (put satmış). IV sıçrayınca zarar eder, baskı altında hedge'i daha sert yapar.</td></tr>
      </tbody>
    </table>
  </div>
</section>

<!-- 4. Scenarios -->
<section>
  <h2>4. Senaryolar: kuvvetler birleşince piyasa ne yapar?</h2>
  <p>Her senaryoyu açtığınızda canlı defter o duruma ayarlanır. Adımları okuyup yukarıdaki sayılarla karşılaştırın.</p>
  <div class="scen" id="scen">
    <details data-s="dull"><summary>"Durgun piyasada asla açığa satma" (Vanna + Charm geri alımı)</summary><div class="body">
      <div class="steps">
        <div>Dealer tipik endeks defterindedir: short put, long call, hisse açığa satılmış.</div>
        <div>Piyasa sakin. Her geçen gün OTM put'ların delta'sı sıfıra erir (<span class="g-charm">Charm</span>). Dealer'ın short put'tan gelen pozitif delta'sı küçülür.</div>
        <div>Sakinlik IV'yi de düşürür. OTM delta'ları bir kez daha erir (<span class="g-vanna">Vanna</span>).</div>
        <div>Defterin delta'sı düştü, ama açık hisse pozisyonu aynı. Dealer artık fazla short. Nötre dönmek için <span class="buy">hisse geri alır</span>.</div>
        <div>Bu alım gün sonu ve gün başında, olay geçtikten sonra IV çökünce en belirgindir. Durgun piyasa yavaş yavaş yukarı sürüklenir.</div>
      </div></div></details>
    <details data-s="squeeze"><summary>Gamma squeeze (dealer short gamma, yükseliş kovalamak zorunda)</summary><div class="body">
      <div class="steps">
        <div>Yatırımcılar yoğun şekilde OTM call alır. Dealer call'da short kalır, yani <b>short gamma</b>.</div>
        <div>Fiyat strike'a yaklaşınca call delta'sı 0'dan 0,5'e, sonra 1'e sıçrar (<span class="g-gamma">Gamma</span>). Dealer'ın negatif delta'sı hızla büyür.</div>
        <div>Nötre dönmek için dealer <span class="buy">hisse alır</span>. Alım fiyatı yukarı iter, delta yine büyür, dealer yine alır.</div>
        <div>Vade kısaldıkça Gamma dar aralıkta yoğunlaşır. 0DTE'de bu döngü en serttir.</div>
      </div></div></details>
    <details data-s="crash"><summary>Düşüşte hızlanma (short gamma + Vanna ters yönde)</summary><div class="body">
      <div class="steps">
        <div>Fiyat düşmeye başlar. Dealer'ın short put'ları ATM'ye yaklaşır, delta'ları büyür (<span class="g-gamma">Gamma</span>). Dealer <span class="sell">hisse satar</span>.</div>
        <div>Düşüşle birlikte IV sıçrar. OTM put delta'ları daha da büyür (<span class="g-vanna">Vanna</span>, strike altında pozitif). Dealer yine <span class="sell">satar</span>.</div>
        <div>Dealer short vega olduğundan IV sıçraması P/L'yi de vurur (<span class="g-vega">Vega</span>). Risk limitleri hedge'i daha agresif yapar.</div>
        <div>Satış fiyatı düşürür, IV'yi yükseltir, döngü kendini besler. Yüksek IV rejiminde düşüşler bu yüzden hızlıdır.</div>
      </div></div></details>
    <details data-s="pin"><summary>OPEX pinning (fiyatın büyük strike'a yapışması)</summary><div class="body">
      <div class="steps">
        <div>Dealer tek bir strike'ta büyük long opsiyon pozisyonu taşır (yatırımcılar oraya çok satmıştır).</div>
        <div>Fiyat strike'ın üstüne çıkınca delta büyür, dealer <span class="sell">satar</span> ve fiyatı aşağı çeker.</div>
        <div>Fiyat strike'ın altına inince delta küçülür, dealer <span class="buy">alır</span> ve fiyatı yukarı çeker (<span class="g-gamma">long Gamma</span>).</div>
        <div>Vade yaklaştıkça <span class="g-charm">Charm</span> da aynı yönde çalışır: strike altında destekleyici, üstünde bastırıcı. Fiyat strike'a mıhlanır.</div>
        <div>Dealer bu strike'ta <b>short</b> olsaydı her şey tersine dönerdi: fiyat strike'tan itilirdi.</div>
      </div></div></details>
    <details data-s="crush"><summary>Olay sonrası "vol crush" (Fed, bilanço geçince)</summary><div class="body">
      <div class="steps">
        <div>Olaydan önce koruma talebi IV'yi şişirir. Dealer yüksek IV'den put satmıştır, bol hisse açığa satmıştır.</div>
        <div>Olay geçer, belirsizlik çözülür, IV çöker. OTM put delta'ları erir (<span class="g-vanna">Vanna</span>).</div>
        <div>Dealer fazla short kalır, <span class="buy">hisse geri alır</span>. Piyasa "haber kötü bile olsa" yükselir. Buna "sell the rumor, buy the news" akışı da denir.</div>
        <div>Aynı anda <span class="g-vega">Vega</span> kanalından opsiyon fiyatları düşer: dealer'ın short vega pozisyonu kazanır, risk bütçesi açılır.</div>
      </div></div></details>
  </div>
</section>

<!-- 5. Market maker mindset -->
<section>
  <h2>5. Market maker gözüyle: hedge neden "kenar" değil, zorunluluktur</h2>
  <div class="grid2">
    <div class="card"><h3>Delta nötr, ama diğer Greek'lerde çıplak</h3><p>Dealer delta'yı sıfırlar ama Gamma, Vega, Vanna ve Charm'ı taşımaya devam eder. Kazancı spread'den ve zımni oynaklığın gerçekleşen oynaklıktan yüksek olmasından gelir. Zararı, hedge'i yetiştiremediği sert hareketlerden gelir.</p></div>
    <div class="card"><h3>Hedge yönü pozisyonun işaretine bağlıdır</h3><p>Aynı strike, aynı vade, aynı IV: dealer long ise fiyatı sakinleştirir, short ise büyütür. Bu yüzden "dealer'lar long gamma mı short gamma mı" sorusu, piyasanın o hafta trend mi yoksa ortalamaya dönüş mü yapacağını anlatan en güçlü ipuçlarından biridir.</p></div>
    <div class="card"><h3>Vanna ve Charm en çok short-stock defterde görünür</h3><p>Dealer'ın tipik endeks defteri hisse açığa satmayı gerektirir. Bu açık pozisyon, zaman ve IV düşüşüyle "fazla" hale gelir ve geri alınır. Vanna/Charm akışlarının genelde yukarı yönlü olmasının nedeni budur. Ancak IV yükselir veya dealer pozisyonu tersine dönerse akış da tersine döner.</p></div>
    <div class="card"><h3>Rejim düşüncesi</h3><p>Üçüncü videodaki market maker'ın dediği gibi: tahmin yerine "nowcast". Şu anki IV seviyesi, skew, dealer gamma işareti ve vadeye kalan süre bir rejim tanımlar. O rejimde hangi akışın baskın olacağı (trend mi, ortalamaya dönüş mü) buradan okunur.</p></div>
  </div>
</section>

