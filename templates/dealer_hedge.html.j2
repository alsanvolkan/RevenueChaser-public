<div class="foot">Hesaplar eğitim amaçlı Black-Scholes modelidir (faiz 0, temettü 0). Gerçek dealer defterleri yüzlerce strike ve vadeden oluşur, IV ve skew ayrı ayrı hareket eder. Yön ve büyüklük ilişkileri doğrudur, sayılar örnektir. Kaynak: {{ source }}. Bu sekme veri okumaz, hiçbir yere istek göndermez ve hiçbir şey kaydetmez.</div>
</div>

<script>
(function(){
  // ---------- Black-Scholes & Greeks ----------
  function ncdf(x){ const t=1/(1+0.2316419*Math.abs(x)); const d=0.3989422804014327*Math.exp(-x*x/2); let p=d*t*(0.319381530+t*(-0.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429)))); return x>=0?1-p:p; }
  function npdf(x){ return Math.exp(-x*x/2)/Math.sqrt(2*Math.PI); }
  // returns per-share greeks for one option. T in years, sigma decimal.
  function greeks(S,K,T,sig,isCall){
    T=Math.max(T,1e-6); const sq=Math.sqrt(T);
    const d1=(Math.log(S/K)+0.5*sig*sig*T)/(sig*sq), d2=d1-sig*sq;
    const delta=isCall?ncdf(d1):ncdf(d1)-1;
    const gamma=npdf(d1)/(S*sig*sq);
    const vega=S*npdf(d1)*sq;                 // per 1.00 of sigma
    const vanna=-npdf(d1)*d2/sig;             // dDelta/dSigma per 1.00 of sigma
    const charm=-npdf(d1)*(-d2)/(2*T);        // dDelta/dT per year (r=0). Sign: dDelta/dt (time forward) = +npdf*d2/(2T)
    // dDelta/d(time passing) = npdf(d1)*d2/(2T) per year, same for call and put
    const charmFwd=npdf(d1)*d2/(2*T);
    return {delta,gamma,vega,vanna,charm:charmFwd};
  }
  // Book: array of {K, isCall, qty} qty = dealer contracts (positive = dealer long), 100 shares each
  const PRESETS={
    index:{name:'Tipik endeks defteri',legs:[{K:95,isCall:false,qty:-100},{K:105,isCall:true,qty:100}]},
    shortgamma:{name:'Short straddle',legs:[{K:100,isCall:true,qty:-100},{K:100,isCall:false,qty:-100}]},
    longgamma:{name:'Long straddle',legs:[{K:100,isCall:true,qty:100},{K:100,isCall:false,qty:100}]},
    pin:{name:'Tek strike long call',legs:[{K:100,isCall:true,qty:200}]}
  };
  const BASE={S:100,iv:20,dte:20};
  let preset='index';
  const $=id=>document.getElementById(id);
  const spot=$('spot'),iv=$('iv'),dte=$('dte');

  function book(S,ivPct,days){
    const sig=ivPct/100, T=days/365; let d=0,g=0,v=0,va=0,ch=0;
    for(const l of PRESETS[preset].legs){ const gr=greeks(S,l.K,T,sig,l.isCall); const n=l.qty*100; d+=gr.delta*n; g+=gr.gamma*n; v+=gr.vega*n; va+=gr.vanna*n; ch+=gr.charm*n; }
    return {delta:d, gamma:g, vega:v/100, vanna:va/100, charm:ch/365}; // vega $ per 1 vol pt; vanna shares per 1 vol pt; charm shares per day
  }
  const fmt=(x,dec=0)=>{ const s=(Math.round(x*Math.pow(10,dec))/Math.pow(10,dec)).toLocaleString('tr-TR',{minimumFractionDigits:dec,maximumFractionDigits:dec}); return (x>0?'+':'')+s; };

  function update(){
    const S=+spot.value, ivP=+iv.value, days=+dte.value;
    $('spotV').textContent=S.toFixed(2); $('ivV').textContent=ivP+'%'; $('dteV').textContent=days;
    const b0=book(BASE.S,BASE.iv,BASE.dte), b=book(S,ivP,days);
    const hedge0=-b0.delta;                 // shares held at baseline
    const need=-b.delta - hedge0;           // extra trade now
    $('bookDelta').textContent=fmt(b.delta);
    $('hedge').textContent=fmt(hedge0);
    const tr=$('trade'); tr.textContent=fmt(need); tr.className='val '+(need>1?'buy':need<-1?'sell':'');
    $('bookGamma').textContent=fmt(b.gamma,0);
    $('bookVanna').textContent=fmt(b.vanna,0);
    $('bookCharm').textContent=fmt(b.charm,0);
    $('bookVega').textContent=fmt(b.vega,0);
    // decomposition (first-order, around baseline): hedge change = -(gamma*dS + vanna*dIV + charm*dt)
    const dS=S-BASE.S, dIV=ivP-BASE.iv, dt=BASE.dte-days;
    const cg=-(b0.gamma*dS), cv=-(b0.vanna*dIV), cc=-(b0.charm*dt);
    const approx=cg+cv+cc; const rest=need-approx;
    const rows=[['Gamma',cg,'var(--gamma)'],['Vanna',cv,'var(--vanna)'],['Charm',cc,'var(--charm)'],['Konveks.',rest,'var(--muted)']];
    const mx=Math.max(1,...rows.map(r=>Math.abs(r[1])));
    $('decomp').innerHTML=rows.map(r=>`<div><span style="color:${r[2]}">${r[0]}</span><div class="bar"><i style="background:${r[2]};left:${r[1]>=0?50:50-Math.abs(r[1])/mx*50}%;width:${Math.abs(r[1])/mx*50}%"></i></div><span class="${r[1]>1?'buy':r[1]<-1?'sell':''}">${fmt(r[1])} hisse</span></div>`).join('');
    // verdict
    const v=$('verdict'); const abs=Math.abs(need);
    let why=[]; if(Math.abs(dS)>0.01) why.push(`fiyat ${dS>0?'yükseldi':'düştü'} (Gamma)`); if(Math.abs(dIV)>0.01) why.push(`IV ${dIV>0?'yükseldi':'düştü'} (Vanna)`); if(Math.abs(dt)>0.01) why.push(`${dt>0?dt+' gün geçti':'vade uzadı'} (Charm)`);
    if(abs<1){ v.innerHTML='<strong>Dealer delta nötr.</strong> Bir kaydırıcıyı oynatın.'; v.style.borderColor='var(--accent)'; }
    else { const act=need>0?'<span class="buy">ALMAK</span>':'<span class="sell">SATMAK</span>'; v.innerHTML=`<strong>Dealer ${fmt(Math.abs(need)).replace('+','')} hisse ${act} zorunda.</strong> Sebep: ${why.join(', ')}. ${need>0?'Bu alım fiyatı yukarı iter.':'Bu satış fiyatı aşağı iter.'} ${b.gamma<0?'Defter short gamma: hedge hareketle aynı yönde, hareketi büyütür.':'Defter long gamma: hedge harekete karşı, hareketi sakinleştirir.'}`; v.style.borderColor=need>0?'var(--buy)':'var(--sell)'; }
    draw1(S,ivP,days,b0); draw2(S,ivP,days);
  }

  // ---------- charts ----------
  const css=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  function axes(ctx,W,H,pad,xmin,xmax,ymin,ymax,xlab,ylab){
    ctx.clearRect(0,0,W,H); ctx.font='12px -apple-system, Segoe UI, Roboto, Arial, sans-serif'; ctx.fillStyle=css('--muted'); ctx.strokeStyle=css('--line'); ctx.lineWidth=1;
    const sx=x=>pad.l+(x-xmin)/(xmax-xmin)*(W-pad.l-pad.r), sy=y=>H-pad.b-(y-ymin)/(ymax-ymin)*(H-pad.t-pad.b);
    for(let x=Math.ceil(xmin/5)*5;x<=xmax;x+=5){ ctx.beginPath(); ctx.moveTo(sx(x),pad.t); ctx.lineTo(sx(x),H-pad.b); ctx.stroke(); ctx.textAlign='center'; ctx.fillText(x,sx(x),H-pad.b+16); }
    const step=niceStep((ymax-ymin)/5);
    for(let y=Math.ceil(ymin/step)*step;y<=ymax;y+=step){ ctx.beginPath(); ctx.moveTo(pad.l,sy(y)); ctx.lineTo(W-pad.r,sy(y)); ctx.stroke(); ctx.textAlign='right'; ctx.fillText(Math.round(y).toLocaleString('tr-TR'),pad.l-6,sy(y)+4); }
    if(ymin<0&&ymax>0){ ctx.strokeStyle=css('--muted'); ctx.beginPath(); ctx.moveTo(pad.l,sy(0)); ctx.lineTo(W-pad.r,sy(0)); ctx.stroke(); }
    ctx.textAlign='center'; ctx.fillText(xlab,(pad.l+W-pad.r)/2,H-4); ctx.save(); ctx.translate(12,(pad.t+H-pad.b)/2); ctx.rotate(-Math.PI/2); ctx.fillText(ylab,0,0); ctx.restore();
    return {sx,sy};
  }
  function niceStep(r){ const p=Math.pow(10,Math.floor(Math.log10(r))); const m=r/p; return (m<1.5?1:m<3.5?2:m<7.5?5:10)*p; }
  function line(ctx,pts,color,width,dash){ ctx.strokeStyle=color; ctx.lineWidth=width; ctx.setLineDash(dash||[]); ctx.beginPath(); pts.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1])); ctx.stroke(); ctx.setLineDash([]); }
  const xs=[]; for(let x=85;x<=115;x+=0.5) xs.push(x);

  function draw1(S,ivP,days,b0){
    const c=$('c1'),ctx=c.getContext('2d'),W=c.width,H=c.height,pad={l:62,r:16,t:16,b:34};
    const cur=xs.map(x=>-book(x,ivP,days).delta), base=xs.map(x=>-book(x,BASE.iv,BASE.dte).delta);
    const all=cur.concat(base); let ymin=Math.min(...all),ymax=Math.max(...all); const m=(ymax-ymin)*0.1||100; ymin-=m; ymax+=m;
    const {sx,sy}=axes(ctx,W,H,pad,85,115,ymin,ymax,'Dayanak fiyat','Gereken hisse hedge\'i');
    line(ctx,xs.map((x,i)=>[sx(x),sy(base[i])]),css('--muted'),1.5,[4,4]);
    line(ctx,xs.map((x,i)=>[sx(x),sy(cur[i])]),css('--accent'),2.5);
    ctx.strokeStyle=css('--fg'); ctx.setLineDash([3,3]); ctx.beginPath(); ctx.moveTo(sx(S),pad.t); ctx.lineTo(sx(S),H-pad.b); ctx.stroke(); ctx.setLineDash([]);
    const y=-book(S,ivP,days).delta; ctx.fillStyle=css('--accent'); ctx.beginPath(); ctx.arc(sx(S),sy(y),5,0,7); ctx.fill();
    const y0=-b0.delta; ctx.fillStyle=css('--muted'); ctx.beginPath(); ctx.arc(sx(BASE.S),sy(y0),4,0,7); ctx.fill();
    ctx.fillStyle=css('--fg'); ctx.textAlign='left'; ctx.font='12px ui-monospace, Consolas, Menlo, monospace'; ctx.fillText('hedge '+fmt(y),sx(S)+8,sy(y)-8);
  }
  function draw2(S,ivP,days){
    const c=$('c2'),ctx=c.getContext('2d'),W=c.width,H=c.height,pad={l:62,r:16,t:16,b:34};
    const g=xs.map(x=>-book(x,ivP,days).gamma), v=xs.map(x=>book(x,ivP,days).vanna), ch=xs.map(x=>-book(x,ivP,days).charm);
    // sign: flow = -(gamma*dS) with dS=+1 ; vanna flow for dIV=-1 => -(vanna*-1)=+vanna ; charm flow for dt=+1 => -charm
    const all=g.concat(v,ch); let ymin=Math.min(...all),ymax=Math.max(...all); const m=(ymax-ymin)*0.1||100; ymin-=m; ymax+=m;
    const {sx,sy}=axes(ctx,W,H,pad,85,115,ymin,ymax,'Dayanak fiyat','Dealer akışı (hisse, + = alım)');
    line(ctx,xs.map((x,i)=>[sx(x),sy(g[i])]),css('--gamma'),2.2);
    line(ctx,xs.map((x,i)=>[sx(x),sy(v[i])]),css('--vanna'),2.2);
    line(ctx,xs.map((x,i)=>[sx(x),sy(ch[i])]),css('--charm'),2.2);
    ctx.strokeStyle=css('--fg'); ctx.setLineDash([3,3]); ctx.beginPath(); ctx.moveTo(sx(S),pad.t); ctx.lineTo(sx(S),H-pad.b); ctx.stroke(); ctx.setLineDash([]);
  }

  // ---------- wiring ----------
  [spot,iv,dte].forEach(el=>el.addEventListener('input',update));
  $('reset').addEventListener('click',()=>{ spot.value=BASE.S; iv.value=BASE.iv; dte.value=BASE.dte; update(); });
  $('presets').addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b) return; preset=b.dataset.p; [...$('presets').children].forEach(x=>x.setAttribute('aria-pressed',x===b)); update(); });
  function setPreset(p){ preset=p; [...$('presets').children].forEach(x=>x.setAttribute('aria-pressed',x.dataset.p===p)); }
  const SCEN={
    dull:()=>{ setPreset('index'); spot.value=100.5; iv.value=15; dte.value=12; },
    squeeze:()=>{ setPreset('shortgamma'); spot.value=104; iv.value=24; dte.value=3; },
    crash:()=>{ setPreset('index'); spot.value=94; iv.value=32; dte.value=18; },
    pin:()=>{ setPreset('pin'); spot.value=101.5; iv.value=18; dte.value=1; },
    crush:()=>{ setPreset('index'); spot.value=100; iv.value=12; dte.value=19; }
  };
  document.querySelectorAll('#scen details').forEach(d=>d.addEventListener('toggle',()=>{ if(d.open&&SCEN[d.dataset.s]){ SCEN[d.dataset.s](); update(); document.querySelectorAll('#scen details').forEach(o=>{ if(o!==d) o.open=false; }); } }));
  update();
  if(window.matchMedia){ window.matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change',update); }
})();
</script>

</body>
</html>
