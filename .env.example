# Copy to .env and fill in what you use. .env is gitignored: never commit real values.
# Every variable below is read by the code (core/credentials.py owns the provider list).
# A missing key degrades only the boards that need it.

# Unusual Whales API key: Earnings Radar, SPX Gamma, LEAPS, Sector Rotation.
UNUSUAL_WHALES_API_KEY=
# FRED key: Sector Rotation RRG weekly closes and the Earnings Radar R6 beta (optional).
FRED_API_KEY=
# OpenFIGI key: security type in the identity refresh (optional; slower without one).
OPENFIGI_API_KEY=
# Alpaca market data key id and its secret: the prices store's daily bars and corporate actions (PR 7).
ALPACA_API_KEY_ID=
# The secret that goes with ALPACA_API_KEY_ID (both are needed; the free plan is enough for daily bars).
ALPACA_API_SECRET_KEY=
# EVREN key: the default Relatedness profile writer (#360; no fee). Read from the environment only, never from .env.
EVREN_API_KEY=
# DeepSeek key: Relatedness profiles and theme naming (optional; off-peak UTC only). Environment only, never .env (#360).
DEEPSEEK_API_KEY=
# Alpha Vantage key: the fundamentals layer's earnings calendar (optional; free tier, 25 requests a day).
ALPHAVANTAGE_API_KEY=
# Extra exact Host names the dashboard answers to, comma-separated (default: loopback only).
RC_ALLOWED_HOSTS=
# Where the IBKR gateway login screen is reachable; the Settings page links to it when it is set.
RC_IBKR_LOGIN_URL=
# The Grafana ops panel holding the builder timer's on / off button; the Data/Health top bar links to it (#527).
RC_BUILDER_TIMER_URL=
# Path of the Claude Code login file, only to override ~/.claude/.credentials.json (allowance gate).
RC_CLAUDE_OAUTH_FILE=
# Path of Hermes's xAI auth.json, only to override its default location (allowance gate).
RC_XAI_AUTH_FILE=

# Contact string for the SEC User-Agent header, "Name email" (SEC asks for one on every request).
RC_SEC_USER_AGENT=

# Turn on the IBKR Gateway login check (empty = off: nothing is contacted, nothing is recorded).
RC_IBKR_LOGIN_CHECK=
# Host the IBKR Gateway's API port is on (optional; default 127.0.0.1).
RC_IBKR_HOST=
# The IBKR Gateway's API port (optional; default 4001).
RC_IBKR_PORT=

# Linux only: "systemd-user" lets the Automations panel install the jobs as systemd user timers (#158).
# Empty = the panel is read-only on Linux, so a server whose jobs already run as system timers gets no second schedule.
RC_SCHEDULER=

# A contact (an e-mail address) for the market-store builder's User-Agent; BLS refuses requests without one.
RC_HTTP_CONTACT=

# WRDS user name for the spine's attended Compustat run, required for it (it picks the line of that user's
# ~/.pgpass, where the password goes, never here).
WRDS_USERNAME=
# The python of the separate venv that has the wrds package; the spine's WRDS worker runs under it (no default).
RC_WRDS_PYTHON=
# 1: the WRDS datasets run from the hourly builder on their cadence instead of a terminal (#344). Set it for
# every process (here, not only on the builder unit) so Settings and the builder agree.
RC_WRDS_UNATTENDED=
# "1" lets the fundamentals layer read UW's numbers of a quarter reported but not yet filed at the SEC and serve
# them as preliminary until the 10-Q arrives (optional; empty = off, the default while the decision is open).
RC_UW_PRELIMINARY=
# The python of the separate venv that has edgartools; the sec_forms section cutter runs under it (no default,
# and no interpreter is a failed cut run, never a silent fall back to our own rule).
RC_EDGARTOOLS_PYTHON=
# Which cutter sec_forms uses: "edgartools" (the default) or "header", the rollback that starts no worker and cuts
# the items with our own versioned rule instead.
RC_SEC_FORMS_CUTTER=
