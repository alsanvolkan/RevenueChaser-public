# Copy to .env and fill in what you use. .env is gitignored: never commit real values.
# Every variable below is read by the code (core/credentials.py owns the provider list).
# A missing key degrades only the boards that need it.

# Unusual Whales API key: Earnings Radar, SPX Gamma, LEAPS, Sector Rotation.
UNUSUAL_WHALES_API_KEY=
# FRED key: Sector Rotation RRG weekly closes and the Earnings Radar R6 beta (optional).
FRED_API_KEY=
# OpenFIGI key: security type in the identity refresh (optional; slower without one).
OPENFIGI_API_KEY=
# DeepSeek key: Relatedness profile extraction and theme naming (optional; off-peak UTC only).
DEEPSEEK_API_KEY=
# Extra exact Host names the dashboard answers to, comma-separated (default: loopback only).
RC_ALLOWED_HOSTS=
# Where the IBKR gateway login screen is reachable; the Settings page links to it when it is set.
RC_IBKR_LOGIN_URL=
# Path of the Claude Code login file, only to override ~/.claude/.credentials.json (allowance gate).
RC_CLAUDE_OAUTH_FILE=
# Path of Hermes's xAI auth.json, only to override its default location (allowance gate).
RC_XAI_AUTH_FILE=

# Contact string for the SEC User-Agent header, "Name email" (SEC asks for one on every request).
RC_SEC_USER_AGENT=

# Settings warns when the local backup folder is above this many GB (optional; default 20).
RAW_STORE_BACKUP_WARN_GB=
# Settings warns when the off-machine backup copy is above this many GB (optional; default 320, 80% of 400 GB).
RAW_STORE_BACKUP_MIRROR_WARN_GB=

# Turn on the IBKR Gateway login check (empty = off: nothing is contacted, nothing is recorded).
RC_IBKR_LOGIN_CHECK=
# Host the IBKR Gateway's API port is on (optional; default 127.0.0.1).
RC_IBKR_HOST=
# The IBKR Gateway's API port (optional; default 4001).
RC_IBKR_PORT=

# Linux only: "systemd-user" lets the Automations panel install the jobs as systemd user timers (#158).
# Empty = the panel is read-only on Linux, so a server whose jobs already run as system timers gets no second schedule.
RC_SCHEDULER=
