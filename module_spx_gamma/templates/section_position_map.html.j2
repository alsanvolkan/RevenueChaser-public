    {% if card.get('delta') is not none %}<span class="delta {% if card['delta'] > 0 %}pos{% elif card['delta'] < 0 %}neg{% else %}flat{% endif %}" title="vs previous report">{% if card['delta'] > 0 %}+{% endif %}{{ card['delta'] }}</span>{% endif %}
