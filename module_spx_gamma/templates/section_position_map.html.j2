<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover">
<title>SPX Critical Thresholds</title>
<script>{{ theme_js }}</script>
<style>
{{ theme_css }}
/* The approved mock (spx-gamma-board-mock.html, 5 Nov 2026): phone-first single column of full-width cards in the
   modern-pro palette. Dark is the default like the shell (THEME_CSS above); light under data-theme="light", or
   "auto" with a light system setting. The shell's names (--card, --border, --fg, ...) are aliased to the mock's,
   so the shared help box, notices and the collapsed detail groups follow the same palette. */
:root{
  --surface:#0d0d10; --elev:#16161a; --panel:#202026; --hover:#2a2a32;
  --t1:#f0f0f5; --t2:#b4b4c0; --t3:#7d7d8c; --line:rgba(255,255,255,.08);
  --pos:#22c55e; --neg:#ef4444; --warn:#fbbf24; --accent:#008ffa;
  --pos-bg:rgba(34,197,94,.12); --neg-bg:rgba(239,68,68,.12); --acc-bg:rgba(0,143,250,.14); --warn-bg:rgba(251,191,36,.12);
  color-scheme:dark;
}
:root[data-theme="light"]{
  --surface:#f8f9fb; --elev:#ffffff; --panel:#eef1f4; --hover:#e3e7eb;
  --t1:#1c2024; --t2:#5f6975; --t3:#737c87; --line:rgba(0,0,0,.09);
  --pos:#16a34a; --neg:#dc2626; --warn:#b7791f; --accent:#0070c9;
  --pos-bg:rgba(22,163,74,.10); --neg-bg:rgba(220,38,38,.10); --acc-bg:rgba(0,143,250,.10); --warn-bg:rgba(183,121,31,.12);
  color-scheme:light;
}
@media (prefers-color-scheme: light){:root[data-theme="auto"]{
  --surface:#f8f9fb; --elev:#ffffff; --panel:#eef1f4; --hover:#e3e7eb;
  --t1:#1c2024; --t2:#5f6975; --t3:#737c87; --line:rgba(0,0,0,.09);
  --pos:#16a34a; --neg:#dc2626; --warn:#b7791f; --accent:#0070c9;
  --pos-bg:rgba(22,163,74,.10); --neg-bg:rgba(220,38,38,.10); --acc-bg:rgba(0,143,250,.10); --warn-bg:rgba(183,121,31,.12);
  color-scheme:light;}}
:root{ --green:var(--pos); --red:var(--neg); --amber:var(--warn); --sky:var(--accent);
  --bg:var(--surface); --card:var(--elev); --border:var(--line); --fg:var(--t1); --bright:var(--t1); --muted:var(--t2);
  --amber-bg:var(--warn-bg); --flat-bg:var(--panel); --blue-bg:var(--acc-bg);
  --pos-line:color-mix(in srgb,var(--pos) 40%,transparent); --neg-line:color-mix(in srgb,var(--neg) 40%,transparent);
  --amber-line:color-mix(in srgb,var(--warn) 40%,transparent);
  --text:var(--t1); --neon:var(--pos);
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace; }
*{ box-sizing:border-box; }
body{ background:var(--surface); color:var(--t1); font:14px/1.5 var(--sans); margin:0; }
.wrap{ max-width:720px; margin:0 auto; padding-block:12px 40px;
  padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px));
  display:flex; flex-direction:column; gap:12px; }
.n{ font-variant-numeric:tabular-nums; }
.lbl{ font-size:11px; font-weight:500; letter-spacing:.06em; text-transform:uppercase; color:var(--t3); }
.muted{ color:var(--t2); } .pos{ color:var(--pos); } .neg{ color:var(--neg); } .warn{ color:var(--warn); }
.sr{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }
header.top{ display:flex; flex-direction:column; gap:8px; }
.row{ display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap; }
h1{ font-size:18px; margin:0; font-weight:600; }
.chips{ display:flex; gap:6px; flex-wrap:wrap; }
.chip{ font-size:12px; font-weight:500; padding:3px 8px; border-radius:4px; background:var(--panel); color:var(--t2); letter-spacing:0; }
.chip.neg,.chip-neg{ background:var(--neg-bg); color:var(--neg); } .chip.pos,.chip-pos{ background:var(--pos-bg); color:var(--pos); }
.header{ font-size:12px; color:var(--t3); }
.card{ background:var(--elev); border-radius:8px; padding:16px; display:flex; flex-direction:column; gap:12px; min-width:0; }
.card h2{ font-size:15px; font-weight:600; margin:0; color:var(--t1); }
.list{ display:flex; flex-direction:column; }
.li{ display:flex; justify-content:space-between; align-items:baseline; gap:12px; padding:9px 0; border-bottom:1px solid var(--line); }
.li:last-child{ border-bottom:0; }
.li .k{ color:var(--t2); min-width:0; }
.li .v{ text-align:right; }
.li.col{ flex-direction:column; align-items:flex-start; gap:2px; } .li.col .k{ color:var(--t1); } .li.col .v{ text-align:left; color:var(--t2); }
.steps{ display:flex; flex-direction:column; gap:8px; }
.step{ display:grid; grid-template-columns:24px 1fr auto; gap:10px; align-items:center; padding:10px; border-radius:6px; background:var(--panel); }
.step.on{ outline:2px solid var(--accent); }
.step .i{ width:22px; height:22px; border-radius:50%; background:var(--elev); display:grid; place-items:center; font-size:12px; font-weight:600; }
.step .r{ text-align:right; font-weight:500; }
.decide{ border-radius:6px; padding:12px; background:var(--acc-bg); display:flex; flex-direction:column; gap:2px; }
.decide b{ display:block; font-size:15px; }
.hero{ display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
.hero .px{ font-size:30px; font-weight:600; }
.grid{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; background:var(--line); border-radius:6px; overflow:hidden; }
@media (min-width:560px){ .grid{ grid-template-columns:repeat(4,minmax(0,1fr)); } }
.cell{ background:var(--elev); padding:10px 12px; display:flex; flex-direction:column; gap:2px; min-width:0; }
.cell b{ font-size:16px; font-weight:600; }
.cell small{ color:var(--t3); font-size:11.5px; }
.scen{ display:flex; flex-direction:column; gap:8px; }
.sc{ border-radius:6px; padding:10px 12px; background:var(--panel); display:grid; grid-template-columns:1fr auto; gap:2px 12px; }
.sc .p{ font-size:18px; font-weight:600; grid-row:span 2; align-self:center; }
.sc .t{ grid-column:1/-1; font-size:12.5px; color:var(--t2); }
.bar{ height:6px; border-radius:3px; background:var(--hover); overflow:hidden; grid-column:1/-1; margin-top:6px; }
.bar i{ display:block; height:100%; }
svg.chart{ width:100%; height:auto; display:block; }
.legend{ display:flex; gap:12px; flex-wrap:wrap; font-size:12px; color:var(--t2); }
.sw{ display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:4px; vertical-align:-1px; }
.zones{ display:flex; flex-direction:column; }
.zone{ display:grid; grid-template-columns:1fr auto; gap:2px 10px; padding:9px 0; border-bottom:1px solid var(--line); }
.zone:last-child{ border:0; }
.tag{ font-size:11px; font-weight:600; padding:2px 6px; border-radius:3px; background:var(--panel); color:var(--t2); }
.tag.neg{ background:var(--neg-bg); color:var(--neg); } .tag.pos{ background:var(--pos-bg); color:var(--pos); } .tag.warn{ background:var(--warn-bg); color:var(--warn); }
.trade{ border-radius:6px; background:var(--panel); padding:12px; display:flex; flex-direction:column; gap:8px; }
.legs{ display:flex; gap:6px; flex-wrap:wrap; }
.leg{ font:500 12.5px var(--mono); padding:3px 6px; border-radius:4px; background:var(--elev); }
.leg.s{ color:var(--neg); } .leg.l{ color:var(--pos); }
.foot,.note,.box-note{ font-size:12px; color:var(--t3); margin:0; }
/* ── the collapsed detail cards (mock 7-10): a 48 px summary row, the body under it ── */
details.card{ padding:0; gap:0; }
details.card > summary{ list-style:none; cursor:pointer; min-height:48px; padding:12px 16px; display:flex; align-items:center; justify-content:space-between; gap:8px; }
details.card > summary::-webkit-details-marker{ display:none; }
details.card > summary::after{ content:"+"; color:var(--t3); font-size:18px; }
details.card[open] > summary::after{ content:"−"; }
details.card > summary > h2{ margin:0; font-size:15px; font-weight:600; }
details.card > .box-inner{ padding:0 16px 16px; display:flex; flex-direction:column; gap:12px; }
/* nested collapsibles inside a card */
details.collapsible:not(.card){ border-top:1px solid var(--line); }
details.collapsible:not(.card) > summary{ list-style:none; cursor:pointer; min-height:44px; padding:10px 0; display:flex; align-items:center; gap:8px; }
details.collapsible:not(.card) > summary::-webkit-details-marker{ display:none; }
details.collapsible:not(.card) > summary::before{ content:"▸"; color:var(--t3); transition:transform .15s ease; }
details.collapsible:not(.card)[open] > summary::before{ transform:rotate(90deg); }
details.collapsible:not(.card) > summary > h2{ margin:0; font-size:14px; font-weight:600; }
details.collapsible:not(.card) > .box-inner{ padding:0 0 12px; display:flex; flex-direction:column; gap:10px; }
.box-inner h2{ font-size:14px; font-weight:600; margin:8px 0 0; }
.box-inner h3{ font-size:13px; font-weight:600; margin:8px 0 0; }
.box{ background:var(--panel); border-radius:6px; padding:12px; }
.at-glance{ background:var(--panel); border-radius:6px; padding:8px 12px; font-size:13px; }
.chart{ max-width:100%; overflow:hidden; }
.chart .plotly-graph-div{ max-width:100%; }
pre{ background:var(--panel); border-radius:6px; padding:12px; overflow-x:auto; font-size:12px; }
ul{ margin:0; padding-left:20px; } li{ margin-bottom:6px; }
/* ── tables (detail cards): rows separated by hairlines; on a phone each row stacks into labelled lines ── */
table{ border-collapse:collapse; width:100%; font-size:13px; }
th,td{ padding:8px 6px; text-align:left; border-bottom:1px solid var(--line); vertical-align:top; }
th{ color:var(--t3); font-size:11px; font-weight:500; letter-spacing:.06em; text-transform:uppercase; }
tr:last-child td{ border-bottom:0; }
.pill,.flow-badge{ display:inline-block; font-size:11px; font-weight:600; padding:2px 8px; border-radius:4px; background:var(--panel); color:var(--t2); }
.pill.green,.flow-green{ background:var(--pos-bg); color:var(--pos); } .pill.red,.flow-red{ background:var(--neg-bg); color:var(--neg); }
.pill.amber,.flow-amber{ background:var(--warn-bg); color:var(--warn); } .flow-flat{ background:var(--panel); color:var(--t2); }
.pos-neg{ font-weight:600; } .pos-neg.pos,.text-green{ color:var(--pos); } .pos-neg.neg,.text-red{ color:var(--neg); } .text-amber{ color:var(--warn); }
.delta{ font-size:12px; font-weight:600; margin-left:6px; } .delta.pos{ color:var(--pos); } .delta.neg{ color:var(--neg); } .delta.flat{ color:var(--t3); }
.grid2{ display:grid; grid-template-columns:1fr; gap:8px; }
@media (min-width:640px){ .grid2{ grid-template-columns:1fr 1fr; } }
.summary-card{ background:var(--panel); border-radius:6px; padding:12px; }
.summary-card .head{ display:flex; align-items:center; gap:8px; margin-bottom:6px; }
.summary-card .title{ font-weight:600; } .summary-card .tag{ background:none; padding:0; color:var(--t3); }
.summary-card .pill{ margin-left:auto; } .summary-card .narrative{ margin:0 0 8px; font-size:13px; }
.chain{ display:flex; flex-direction:column; gap:6px; } .chain .node{ background:var(--panel); border-radius:6px; padding:8px 12px; }
.chain .n-icon{ color:var(--accent); font-size:11px; letter-spacing:.06em; } .chain .n-label{ font-weight:600; }
.chain .node p{ margin:4px 0 0; font-size:12.5px; color:var(--t2); } .chain .arrow{ display:none; }
.relation-grid{ display:grid; grid-template-columns:1fr; gap:8px; }
@media (min-width:640px){ .relation-grid{ grid-template-columns:1fr 1fr; } }
.relation-card{ background:var(--panel); border-radius:6px; padding:12px; }
.relation-card .r-greek{ font-weight:600; margin-right:8px; } .relation-card .r-headline{ color:var(--pos); font-size:12px; font-weight:600; }
.relation-card p{ margin:6px 0; font-size:13px; }
.prediction-container{ display:flex; flex-direction:column; gap:10px; }
.prediction-hero{ display:flex; flex-wrap:wrap; align-items:center; gap:12px; background:var(--panel); border-radius:6px; padding:12px; }
.bias-badge{ font-size:12px; font-weight:600; padding:4px 10px; border-radius:4px; white-space:normal; }
.bias-badge.bullish{ background:var(--pos-bg); color:var(--pos); } .bias-badge.bearish{ background:var(--neg-bg); color:var(--neg); }
.bias-badge.neutral{ background:var(--warn-bg); color:var(--warn); }
.hero-metric{ display:flex; flex-direction:column; } .hero-metric span{ font-size:11px; color:var(--t3); text-transform:uppercase; letter-spacing:.06em; }
.hero-note{ font-size:12px; color:var(--t3); }
.scenario-table tr.row-bullish td:first-child{ color:var(--pos); font-weight:600; }
.scenario-table tr.row-neutral td:first-child{ color:var(--warn); font-weight:600; }
.scenario-table tr.row-bearish td:first-child{ color:var(--neg); font-weight:600; }
.divergence-bar{ display:flex; flex-wrap:wrap; gap:6px 16px; font-size:12px; }
.band-row{ display:grid; grid-template-columns:1fr; gap:8px; }
@media (min-width:640px){ .band-row{ grid-template-columns:1fr 1fr; } }
.band{ border-radius:6px; padding:10px 12px; background:var(--panel); }
.band.green{ background:var(--pos-bg); } .band.red{ background:var(--neg-bg); }
.band h3{ margin:0 0 4px; font-size:13px; } .band .big{ font-size:15px; font-weight:600; } .band .sub{ font-weight:400; color:var(--t2); font-size:12px; }
.ib-legs{ overflow:visible; }
.footer{ font-size:12px; color:var(--t3); }
@media (max-width:640px){
  table.stack{ display:block; }
  table.stack thead{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
  table.stack thead tr, table.stack th{ display:block; width:1px; height:1px; padding:0; border:0; overflow:hidden; }
  table.stack tbody, table.stack tr{ display:block; }
  table.stack tr{ border-bottom:1px solid var(--line); padding:6px 0; }
  table.stack tr:last-child{ border-bottom:0; }
  table.stack td{ display:flex; justify-content:space-between; align-items:baseline; gap:16px; border:0; padding:3px 0;
    text-align:right; min-width:0; overflow-wrap:anywhere; }
  table.stack td::before{ content:attr(data-label); flex:0 0 40%; text-align:left; color:var(--t3); font-size:11px;
    text-transform:uppercase; letter-spacing:.06em; }
  table.stack td[data-label=""]::before{ display:none; }
  table.stack.plain td{ display:block; text-align:left; }
  .modebar-container{ display:none !important; }
}
@media (prefers-reduced-motion:no-preference){ .step.on{ transition:outline-color .2s; } }
@media print{
  :root{ --surface:#fff; --elev:#fff; --panel:#f2f2f2; --t1:#111; --t2:#444; --t3:#555; --line:#ccc; }
  details.card > summary::after{ content:""; }
}
</style>
<script src="/static/vendor/plotly.min.js"></script>
</head>
<body>
<div class="wrap">
{{ provider_banner }}{{ quality_banner }}{% if builder_line %}<div class="note store-source">{{ builder_line }}</div>{% endif %}

<header class="top">
  <div class="row"><h1>SPX Gamma</h1></div>
  <div class="chips">{% for c in chips %}<span class="chip{% if c.tone %} {{ c.tone }}{% endif %}">{{ c.text }}</span>{% endfor %}</div>
  <div class="header">{{ header.ticker }} &middot; Price {{ header.price_source }} &middot; Report date {{ header.report_date }} &middot; Sessions {{ header.sessions }} &middot; Last sync: {{ header.last_sync }}&nbsp;EOD &middot; {{ header.source }}</div>
</header>
{{ help_block }}

<!-- 1. The 22:00 decision: the three steps of the 02-06 Nov report, then what the close reads -->
{% set cc_states = close_check.steps | map(attribute='state') | list %}
<section class="card" aria-labelledby="h-dec" id="g1">
  <div class="row"><h2 id="h-dec">Close check (22:00 Amsterdam)</h2><span class="lbl">02–06 Nov rule</span></div>
  <div class="steps">
  {% for st in close_check.steps %}
    {% set tone = 'neg' if st.state in ('stress', 'negative', 'downside') else 'pos' if st.state in ('calm', 'positive', 'upside') else 'warn' if st.state is none else '' %}
    <div class="step{% if (st.state is none and loop.index0 == (cc_states.index(none) if none in cc_states else -1)) or (none not in cc_states and loop.first) %} on{% endif %}"><span class="i">{{ loop.index }}</span><span><b>{{ st.step }}</b> · {{ st.reading }}</span><span class="r {{ tone }}">{% if st.state is none %}n/a{% elif st.step == 'Week gamma' and week_gamma %}{{ week_gamma.net_gamma }}{% else %}{{ st.state | capitalize }}{% endif %}</span></div>
  {% endfor %}
  </div>
  {% set band = close_check.steps[0] %}
  <div class="decide"><span class="lbl">The close reads</span><b>{{ band.state | capitalize if band.state else "Price band n/a" }}</b><span class="muted">{{ close_check.note }}</span></div>
</section>

<!-- 2. At a glance: the hero spot and the eight-cell grid -->
<section class="card" aria-labelledby="h-glance" id="g2">
  <h2 class="sr">At a glance</h2>
  <div class="hero"><span class="lbl" id="h-glance">SPX</span><span class="px n">{{ glance.spot }}</span><span class="muted n">{{ glance.to_flip }}</span></div>
  <div class="grid">
  {% for c in glance.cells %}<div class="cell"><span class="lbl">{{ c.label }}</span><b class="n{% if c.get('tone') %} {{ c.tone }}{% endif %}">{{ c.value }}</b><small>{{ c.note }}</small></div>{% endfor %}
  </div>
  <div class="list">
    <div class="li"><span class="k">Regime</span><span class="v">{{ header_strip.regime }}</span></div>
    <div class="li"><span class="k">Net GEX (OI) · 1D / 1W</span><span class="v n"><span class="{{ header_strip.net_gex_tone }}">{{ header_strip.net_gex }}</span> · {{ header_strip.net_gex_delta_1d }} / {{ header_strip.net_gex_delta_1w }}</span></div>
    <div class="li"><span class="k">Net DEX · net vanna · live charm</span><span class="v n">{{ header_strip.net_dex }} · {{ header_strip.net_vanna }} · {{ header_strip.live_charm }}</span></div>
    <div class="li"><span class="k">Charm pin · vanna pin</span><span class="v n">{{ header_strip.charm }} · {{ header_strip.vanna }}</span></div>
    <div class="li"><span class="k">VIX</span><span class="v n">{{ header_strip.vix }}</span></div>
  </div>
</section>

<!-- 3. What would change the regime -->
<section class="card" aria-labelledby="h-reg" id="g3">
  <h2 id="h-reg">What would change the regime</h2>
  {% if regime_conditions %}<div class="list">
  {% for c in regime_conditions %}<div class="li col"><span class="k">{{ c.trigger }}</span><span class="v">{{ c.then }}</span></div>{% endfor %}
  </div>{% else %}<p class="note">Not enough levels in this snapshot to state the regime conditions.</p>{% endif %}
</section>

<!-- 4. Scenarios and the Brier record -->
<section class="card" aria-labelledby="h-sc" id="g4">
  <div class="row"><h2 id="h-sc">Scenarios</h2><span class="lbl">{{ scenarios.report_as_of }} rule</span></div>
  <div class="scen">
  {% for s in scenarios.scenarios %}
    {% set tone = 'pos' if s.name == 'Upside' else 'neg' if s.name == 'Downside' else '' %}
    {% set pct = ((s.p or 0) * 100) | round | int %}
    <div class="sc"><span class="{{ tone }}">{{ s.name }}</span><span class="p n">{{ pct }}%</span><span class="muted n">{{ s.range }} · {{ s.trade }}{% if s.asymmetry is not none %} · asymmetry {{ "%.2f"|format(s.asymmetry) }}{% endif %}</span>{% if scenarios.get("hourly_source") and s.get("hourly_text") %}<span class="t">Hourly close: {{ s.hourly_text }}</span>{% endif %}<div class="bar"><i style="width:{{ pct }}%;background:var(--{{ tone or 'accent' }})"></i></div></div>
  {% endfor %}
  </div>
  <details class="collapsible"><summary><h2 class="sum-h">How the bands are built</h2></summary><div class="box-inner"><p class="note">{{ scenarios.note }}</p></div></details>{% if scenarios.get("hourly_source") %}{% set hs = scenarios.hourly_source %}
  <p class="note">Hourly closes from {{ hs.week_start }} ({{ hs.rows|length }} so far): UW {{ hs.source }} 30-minute bars at the report times (10:30 … 15:30 New York and the close), scaled to SPX by {{ "%.4f"|format(hs.ratio) }} (stored SPX close / SPY close of the last shared session). A proxy: the report reads IBKR's SPX hourly close.{% if hs.rows %} Last: {{ hs.rows[-1].amsterdam }} Amsterdam, {{ "{:,.1f}".format(hs.rows[-1].close) }}.{% endif %}</p>{% endif %}{% if historical.hourly_triggers %}
  <p class="note">n/a (historical): The SPY 30-minute bars were fetched in a later session than this day, so no hourly-close state is shown.</p>{% endif %}
  <div class="li"><span class="k">Brier · Scored days: {{ brier.scored_count }}</span><span class="v n">avg {{ brier.average if brier.average is not none else "—" }} · ref {{ ("%.4f"|format(brier.equal_weight_reference)) if brier.equal_weight_reference is number else brier.equal_weight_reference }}{%- if brier.skill_score is number %} · <span class="muted">Skill score:</span> {{ "%+.2f"|format(brier.skill_score) }}{%- endif %}{%- if brier.base_rate_reference is number %} · base rate {{ "%.4f"|format(brier.base_rate_reference) }}{%- endif %}</span></div>
  <p class="note">{{ brier.verdict }}</p>
</section>

<!-- 5. The week gamma map: bars by strike, spot and flip lines, the zones -->
{% if week_gamma %}<section class="card" aria-labelledby="h-wk" id="g5">
  <div class="row"><h2 id="h-wk">Week gamma map</h2><span class="lbl">through {{ week_gamma.target }} · net {{ week_gamma.net_gamma }}</span></div>
  {% if week_chart %}{% set w = week_chart %}<svg class="chart" viewBox="0 0 {{ w.w }} {{ w.h }}" role="img" aria-label="{{ w.label }}">
    {% for g in w.grid %}<line x1="{{ w.left }}" x2="{{ w.right }}" y1="{{ g.y }}" y2="{{ g.y }}" stroke="var(--line)"/><text x="{{ w.left - 6 }}" y="{{ g.y + 4 }}" text-anchor="end" font-size="11" fill="var(--t3)">{{ g.label }}</text>{% endfor %}
    {% for b in w.bars %}<rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}" rx="1" fill="var(--{{ b.tone }})"><title>{{ b.title }}</title></rect>{% endfor %}
    {% for t in w.ticks %}<text x="{{ t.x }}" y="{{ w.h - 10 }}" text-anchor="middle" font-size="11" fill="var(--t3)">{{ t.label }}</text>{% endfor %}
    {% if w.spot %}<line x1="{{ w.spot.x }}" x2="{{ w.spot.x }}" y1="{{ w.top }}" y2="{{ w.bottom }}" stroke="var(--accent)" stroke-width="2" stroke-dasharray="4 3"/><text x="{{ w.spot.x - 4 }}" y="{{ w.top + 10 }}" text-anchor="end" font-size="11" fill="var(--accent)">{{ w.spot.label }}</text>{% endif %}
    {% if w.flip %}<line x1="{{ w.flip.x }}" x2="{{ w.flip.x }}" y1="{{ w.top }}" y2="{{ w.bottom }}" stroke="var(--warn)" stroke-width="1.5"/><text x="{{ w.flip.x + 4 }}" y="{{ w.top + 10 }}" font-size="11" fill="var(--warn)">{{ w.flip.label }}</text>{% endif %}
  </svg>
  <div class="legend"><span><span class="sw" style="background:var(--pos)"></span>positive gamma (brakes)</span><span><span class="sw" style="background:var(--neg)"></span>negative gamma (accelerates)</span><span><span class="sw" style="background:var(--accent)"></span>spot</span><span><span class="sw" style="background:var(--warn)"></span>HVL</span></div>{% endif %}
  <div class="li"><span class="k">Turning point</span><span class="v n"><b>{{ week_gamma.turning_point }}</b> · {{ week_gamma.expiries }} expiries</span></div>
  <div class="zones">
  {% for z in week_gamma.zones %}
    {% set tone = 'neg' if z.tone == 'red' else 'pos' if z.tone == 'green' else 'warn' if z.kind == 'Braked staircase' else '' %}
    <div class="zone"><span><span class="tag{% if tone %} {{ tone }}{% endif %}">{{ z.kind }}</span> <span class="n">{{ z.range }}</span></span><span class="n {{ tone if tone in ('pos', 'neg') else '' }}">{{ z.gamma }}</span><span class="muted" style="grid-column:1/-1">{{ z.share }} of the window's |gamma|</span></div>
  {% endfor %}
  </div>
  <p class="foot">{{ week_gamma.rule }}</p>
</section>{% endif %}

<!-- 6. Trade structures: report structures priced on the target Friday, each a card with its legs -->
{% if structures or iron_butterfly or iron_butterfly_na or historical.structures %}<section class="card" aria-labelledby="h-tr" id="g6">
  <div class="row"><h2 id="h-tr">Trade structures{% if structures %} ({{ structures.expiry }}){% endif %}</h2><span class="chip">{{ structures.label if structures else "report structure · not advice" }}</span></div>
  {% if historical.structures %}
  <p class="note">n/a (historical): The target Friday's option chain was fetched in a later session than this day, so no structure is priced.</p>
  {% elif structures %}
  {% for r in structures.rows %}<div class="trade">
    <div class="row"><b>{{ r.name }}</b><span class="lbl">{{ r.family }}</span></div>
    <div class="legs">{% for l in r.get("leg_chips") or [] %}<span class="leg {{ 'l' if l.long else 's' }}">{{ l.text }}</span>{% endfor %}</div>
    <div class="list">
      <div class="li"><span class="k">Net (SPX pts)</span><span class="v n">{{ r.net }}{% if r.missing %} <span class="muted">no quote: {{ r.missing }}</span>{% endif %}</span></div>
      <div class="li"><span class="k">Max profit / max loss</span><span class="v n">{{ r.max_profit }} / {{ r.max_loss }}</span></div>
      <div class="li"><span class="k">Breakevens</span><span class="v n">{{ r.breakevens }}</span></div>
      <div class="li"><span class="k">Reward / risk · XSP</span><span class="v n">{{ r.reward_risk }} · {{ r.xsp }}</span></div>
    </div>
  </div>{% endfor %}
  <p class="foot">Strikes are this week's band edges snapped to the 25-point grid; wings 50 points beyond the short leg; the debit spreads buy at the confirm level. Mid prices at expiry payoff, before fees and slippage. The report's entry, stop and sizing rules are not applied.</p>
  {% endif %}{% if iron_butterfly_na and not iron_butterfly %}
  <p class="note">Iron Butterfly n/a: {{ iron_butterfly_na }}.</p>{% endif %}
  {% if iron_butterfly %}<div class="trade">
    <div class="row"><b>Iron Butterfly — Pin Harvest</b><span class="lbl">{{ iron_butterfly.signal.signal or 'N/A' }}</span></div>
    {% if historical.iron_butterfly %}
    <p class="note">n/a (historical): The option chain was fetched in a later session than this day.</p>
    {% else -%}
    <div class="legs">{% for leg in iron_butterfly.legs %}<span class="leg {{ 'l' if leg.action == 'BUY' else 's' }}">{{ '+' if leg.action == 'BUY' else '−' }}{{ leg.strike | fmtnum('{:.0f}') }}{{ leg.type[:1] }}</span>{% endfor %}</div>
    <div class="list">
      <div class="li"><span class="k">Center (Pin) · Wing Width</span><span class="v n">{{ iron_butterfly.center_strike | fmtnum }} · {{ iron_butterfly.wing_width | fmtnum }}</span></div>
      <div class="li"><span class="k">Net Credit</span><span class="v n pos">+{{ iron_butterfly.net_credit | fmtnum }}</span></div>
      <div class="li"><span class="k">Max Risk</span><span class="v n neg">{{ iron_butterfly.max_risk | fmtnum }}</span></div>
      <div class="li"><span class="k">Return on Risk</span><span class="v n">1 : {{ iron_butterfly.return_on_risk | fmtnum('{:,.2f}') }}</span></div>
      <div class="li"><span class="k">Net Theta /day</span><span class="v n">{{ iron_butterfly.net_theta | fmtnum }}</span></div>
      <div class="li"><span class="k">Breakevens</span><span class="v n">{{ iron_butterfly.lower_breakeven | fmtnum }} – {{ iron_butterfly.upper_breakeven | fmtnum }}</span></div>
    </div>
    <p class="foot">{% if iron_butterfly.get("source") in ("model", "mixed") %}<b>No live quotes at the Fetch: {{ "all" if iron_butterfly.source == "model" else "some" }} legs are modeled (Black-Scholes on UW's IV); a model price is not a market price.</b>
    {% endif %}Wing width from expected move ({{ iron_butterfly.width_source.em_points | fmtnum }} pts @ IV {{ iron_butterfly.width_source.iv_used | fmtnum('{:,.2f}') }}) on the {{ iron_butterfly.width_source.band }} grid.
    {{ iron_butterfly.signal.action }}{% if iron_butterfly.signal.target %} → target {{ iron_butterfly.signal.target | fmtnum }}{% endif %}.</p>
    <details class="collapsible"><summary><h2 class="sum-h">Leg quotes</h2></summary><div class="box-inner ib-legs">
      <table class="stack">
        <thead><tr><th>Action</th><th>Type</th><th>Strike</th><th>Mid</th><th>IV</th><th>Θ /day</th></tr></thead>
        <tbody>{% for leg in iron_butterfly.legs %}<tr><td data-label="Action" class="{{ 'neg' if leg.action == 'SELL' else 'pos' }}">{{ leg.action }}</td><td data-label="Type">{{ leg.type }}</td><td data-label="Strike">{{ leg.strike | fmtnum }}</td><td data-label="Mid">{{ leg.mid | fmtnum('{:,.2f}') }}</td><td data-label="IV">{{ leg.iv | fmtnum('{:,.1%}') }}</td><td data-label="Θ /day">{{ leg.theta | fmtnum('{:,.1f}') }}</td></tr>{% endfor %}</tbody>
      </table>
    </div></details>
    {%- endif %}
  </div>{% endif %}
</section>{% endif %}

<!-- Position map, strike profile, liquidity layer and the DTE walls: the earlier board's charts, collapsed -->
