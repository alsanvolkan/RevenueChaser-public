{% if flow_signal %}
<div class="box" style="margin-top:14px">
  <div class="ag-label">Volume &amp; Flow Confluence Analysis</div>
  <div class="at-glance" style="margin:8px 0 0"><span class="flow-badge {{ 'flow-' + flow_signal.tone }}">{{ flow_signal.label }}</span> <span style="color:var(--fg)">{{ flow_signal.narrative }}</span></div>
</div>
{% endif %}
<h2>Options Volume &amp; P/C</h2>
{% if options_volume and historical.options_volume %}
<div class="note">n/a (historical): Options volume was fetched in a later session than this day.</div>
{% elif options_volume %}
<div class="at-glance" style="margin-top:0"><span class="muted">What it tells you —</span> whether options flow is protective (put-heavy) or directional, and how rich the premium is.</div>
<table class="stack">
  <thead><tr><th>Metric</th><th>Value</th></tr></thead>
  <tbody>
    <tr><td data-label="Metric">Put/Call Volume</td><td data-label="Value">{{ options_volume.pc_ratio|round(2) if options_volume.pc_ratio is not none else "N/A" }}</td></tr>
    <tr><td data-label="Metric">Call Volume / Put Volume</td><td data-label="Value">{{ options_volume.call_volume }} / {{ options_volume.put_volume }}</td></tr>
    <tr><td data-label="Metric">Net Call Premium</td><td data-label="Value">{{ options_volume.net_call_premium }}</td></tr>
    <tr><td data-label="Metric">Net Put Premium</td><td data-label="Value">{{ options_volume.net_put_premium }}</td></tr>
  </tbody>
</table>
{% else %}
<div class="note">Options volume data unavailable.</div>
{% endif %}

<h2>Cross-Signal Synthesis</h2>
<div class="at-glance">
  <span class="muted">Stance:</span>
  <span class="pos-neg {{ 'pos' if signal_matrix.tone == 'green' else 'neg' if signal_matrix.tone == 'red' else '' }}">{{ signal_matrix.stance }}</span>
  <span class="muted"> &middot; {{ signal_matrix.summary }}</span>
</div>
<table class="stack">
  <thead><tr><th>Signal</th><th>Lean</th></tr></thead>
  <tbody>
  {% for r in signal_matrix.rows %}<tr><td data-label="Signal">{{ r.title }}</td><td data-label="Lean"><span class="pill {{ r.tone }}">{{ r.label }}</span></td></tr>
  {% endfor %}
  </tbody>
</table>

{% if prediction and prediction.bias %}
<div class="prediction-container">
  <!-- Top Hero Status Bar -->
  <div class="prediction-hero">
    <div class="bias-badge {{ 'bullish' if prediction.bias.startswith('BULLISH') else 'bearish' if prediction.bias.startswith('BEARISH') else 'neutral' }}">EXPECTED DIRECTION: {{ prediction.bias }}{% if prediction.confidence is not none %} ({{ prediction.confidence }}% Conf){% endif %}</div>
    {% if prediction.active_pin is not none %}<div class="hero-metric"><span>Active Pin</span><strong>{{ prediction.active_pin | fmtnum }}{% if prediction.pin_flag == 'EXPIRING_PIN_FLIP' %}&nbsp;⚑{% endif %}</strong></div>{% endif %}
    {% if prediction.upside_trigger is not none %}<div class="hero-metric"><span>Accel Trigger</span><strong>&gt; {{ prediction.upside_trigger | fmtnum }}</strong></div>{% endif %}
    {% if prediction.downside_floor is not none %}<div class="hero-metric"><span>Bounce Floor</span><strong>{{ prediction.downside_floor | fmtnum }}</strong></div>{% endif %}
  </div>{% if pin_line %}
  <div class="note pin-source">{{ pin_line }}</div>{% endif %}

  <!-- Scenario Matrix Table -->
  <div class="overflow-x-auto">
  <table class="scenario-table stack">
    <thead><tr><th>Scenario</th><th>Trigger Level</th><th>Dealer Hedging Action</th><th>Target Zone</th></tr></thead>
    <tbody>
    {% for s in prediction.scenarios %}
    <tr class="{{ s.class }}">
      <td data-label="Scenario">{{ s.name }}</td><td data-label="Trigger Level">{{ s.trigger }}</td><td data-label="Dealer Hedging Action">{{ s.hedging }}</td><td data-label="Target Zone">{{ s.target }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>

  <!-- OI vs Volume Divergence Status -->
  {% if prediction.divergence %}
  <div class="divergence-bar">
    {% for d in prediction.divergence[:4] %}
    <span class="status-item">
      <strong>{{ d.strike | fmtnum }} {{ d.side }}:</strong>
      <span class="{{ 'text-amber' if d.flag == 'WALL_DECAYING' else 'text-red' }}">{{ 'DECAYING' if d.flag == 'WALL_DECAYING' else 'FORTIFYING' }} (OI: {{ d.gex_oi | fmt_signed_compact }} | Vol: {{ d.gex_vol | fmt_signed_compact }})</span>
    </span>
    {% endfor %}
  </div>
  {% endif %}

  {% if prediction.note %}<div class="hero-note">ⓘ {{ prediction.note }}</div>{% endif %}
</div>
{% endif %}
</div>
</details>

<details class="card collapsible group" id="g10">
<summary><h2 class="sum-h">10 · Positioning</h2></summary>
<div class="box-inner">
{% if front_share %}<div class="at-glance" style="margin:8px 0 0"><span class="muted">Front-expiry share of Net GEX —</span> {{ front_share.share }} ({{ front_share.expiry }}: {{ front_share.front }} of {{ front_share.total }})</div>{% endif %}

<h2>Max Pain</h2>
{% if max_pain and historical.max_pain %}
<div class="note">n/a (historical): Max pain was fetched in a later session than this day.</div>
{% elif max_pain %}
<div class="at-glance" style="margin-top:0"><span class="muted">What it tells you —</span> the strike where the most options expire worthless; a structural gravity center, NOT a directional signal.</div>
<table class="stack">
  <thead><tr><th>Expiry</th><th>Max Pain</th><th>% from Spot</th></tr></thead>
  <tbody>
  {% for m in max_pain %}<tr><td data-label="Expiry">{{ m.expiry }}</td><td data-label="Max Pain">{{ m.max_pain }}</td><td data-label="% from Spot">{{ m.distance_pct }}</td></tr>{% endfor %}
  </tbody>
</table>
{% if max_pain_count %}<div class="at-glance" style="margin:8px 0 0">{{ max_pain_count.below }} below spot · {{ max_pain_count.above }} above{% if max_pain_count.at %} · {{ max_pain_count.at }} at spot{% endif %}</div>{% endif %}
{% else %}
<div class="note">Max pain data unavailable.</div>
{% endif %}

<h2>Expiry Distribution</h2>
<table class="stack">
  <thead><tr><th>Expiry</th><th>DTE</th><th>Band</th><th>Net GEX</th><th>Net DEX</th></tr></thead>
  <tbody>
  {% for e in summary_expiry %}
  <tr><td data-label="Expiry">{{ e.expiry }}</td><td data-label="DTE">{{ e.dte }}</td><td data-label="Band">{{ e.band }}</td>
    <td data-label="Net GEX">{{ e.net_gex }}</td><td data-label="Net DEX">{{ e.net_dex }}</td></tr>
  {% endfor %}
  </tbody>
</table>

<h2>CFTC COT — E-mini S&amp;P 500 (TFF)</h2>
{% if cftc %}
<div class="at-glance" style="margin-top:0"><span class="muted">What it tells you —</span> how big players (asset managers, leveraged funds, dealers) are positioned; weekly-delayed but regular.</div>
<div class="note">Report date {{ cftc.report_date or "n/a" }} · Open interest {{ cftc.open_interest or "n/a" }}{% if store_labels.cftc %} · {{ store_labels.cftc }}{% endif %}</div>
<table class="stack">
  <thead><tr><th>Group</th><th>Long</th><th>Short</th><th>Net</th><th>Weekly Δ</th></tr></thead>
  <tbody>
  {% for c in cftc.rows %}
  <tr><td data-label="Group">{{ c.group }}</td>
    <td data-label="Long">{{ c.long|fmtnum('{:,.0f}') }}</td>
    <td data-label="Short">{{ c.short|fmtnum('{:,.0f}') }}</td>
    <td data-label="Net" class="pos-neg {{ 'pos' if (c.net or 0) >= 0 else 'neg' }}">{{ c.net|fmtnum('{:+,.0f}') }}</td>
    <td data-label="Weekly Δ">{% if cftc.change_gap and c.change is none %}n/a (gap){% else %}{{ c.change|fmtnum('{:+,.0f}') }}{% endif %}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<div class="note">{{ store_notes.cftc or "CFTC COT data unavailable." }}</div>
{% endif %}

<h2>Net Delta — Weekly Trend</h2>
<div class="at-glance" style="margin-top:0"><span class="muted">What it tells you —</span> one week's hedging
direction can mislead; the trend only shows over consecutive weeks. This is the summed call and put delta across
every expiry, at each Friday close.</div>
{% if net_delta_trend.rows %}
<table class="stack">
  <thead><tr><th>Friday close</th><th>Call + put delta</th></tr></thead>
  <tbody>
  {% for r in net_delta_trend.rows %}
  <tr><td data-label="Friday close">{{ r.date }}</td><td data-label="Call + put delta">{{ r.net_delta | fmtnum('{:,.0f}') }}</td></tr>
  {% endfor %}
  </tbody>
</table>
<div class="note">{{ net_delta_trend.have }} of {{ net_delta_trend.want }} weekly closes stored
{%- if net_delta_trend.direction %}; over this window the total went <b>{{ net_delta_trend.direction }}</b>{% endif %}.
The board keeps one row per rendered day and the provider does not serve old days, so the table fills forward one
Friday a week.</div>
{% else %}
<div class="note">No Friday close stored before this day yet, so there is no weekly trend to show.</div>
{% endif %}

<h2>Level Migration vs Prior Snapshot</h2>
<table class="stack">
  <thead><tr><th>Level</th><th>This Week</th><th>Previous</th><th>Δ</th></tr></thead>
  <tbody>
  {% for m in migration %}
  <tr><td data-label="Level">{{ m.level }}</td><td data-label="This Week">{{ m.now | fmtnum }}</td>
    <td data-label="Previous">{{ m.prev | fmtnum }}</td>
    <td data-label="Δ">{{ m.delta | fmtnum('{:+,.1f}') }}</td></tr>
  {% endfor %}
  </tbody>
</table>

<h2>Top-10 GEX Strikes</h2>
<table class="stack">
  <thead><tr><th>#</th><th>Strike</th><th>Net GEX</th><th>Gamma-Flip Side</th></tr></thead>
  <tbody>
  {% for t in top_gex %}
  <tr><td data-label="#">{{ loop.index }}</td><td data-label="Strike">{{ t.strike|round|int }}</td>
    <td data-label="Net GEX" class="pos-neg {{ 'pos' if t.net_gex >= 0 else 'neg' }}">{{ t.net_gex | fmtnum('{:+,.1f}') }}</td>
    <td data-label="Gamma-Flip Side">{{ t.side }}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
</details>

<details class="card collapsible group" id="g11">
<summary><h2 class="sum-h">11 · Calendar and reference</h2></summary>
<div class="box-inner">
{% if vol_calendar %}<h3 style="margin:0 0 8px">Volatility calendar to the target Friday</h3>
<table class="stack">
  <thead><tr><th>When (Amsterdam)</th><th>Event</th><th>Prior</th><th>Forecast</th></tr></thead>
  <tbody>{% for e in vol_calendar %}<tr><td data-label="When (Amsterdam)">{{ e.local }}</td><td data-label="Event">{% if e.high_impact %}<b>{{ e.event }}</b> <span class="flow-badge flow-amber">high impact</span>{% else %}{{ e.event }}{% endif %}</td><td data-label="Prior">{{ e.prev or "" }}</td><td data-label="Forecast">{{ e.forecast or "" }}</td></tr>{% endfor %}</tbody>
</table>{% endif %}

<details class="collapsible">
<summary><h2 class="sum-h">Details</h2></summary>
<div class="box-inner">
<table class="stack">
  <thead><tr><th>Level</th><th>Value</th><th>Reference Type</th><th>Method / Disclosure</th></tr></thead>
  <tbody>
  {% for row in details %}<tr><td data-label="Level">{{ row.level }}</td><td data-label="Value">{{ row.value }}</td><td data-label="Reference Type">{{ row.ref }}</td><td data-label="Method / Disclosure">{{ row.method }}</td></tr>
  {% endfor %}
  </tbody>
</table>

</div>
</details>

<details class="collapsible">
<summary><h2 class="sum-h">How to read this map (Gamma)</h2></summary>
<div class="box-inner">
<ul>
  <li>Call Wall ({{ how_to_read.call_wall }}): magnetic ceiling — dealers may sell into rallies (take-profit zone).</li>
  <li>Put Wall ({{ how_to_read.put_wall }}): trampoline floor — dealers may buy into dips (bounce zone).</li>
</ul>
<p>Gamma Flip ({{ how_to_read.flip }}) — the volatility turning point:</p>
<pre>[ ABOVE FLIP LEVEL ]  ->  Positive Gamma Zone  ->  Volatility Suppressed (Calm)
------------------------------------------------------------------------------
[ GAMMA FLIP LEVEL ]  ->  The Volatility Turning Point
------------------------------------------------------------------------------
[ BELOW FLIP LEVEL ]  ->  Negative Gamma Zone  ->  Volatility Accelerated (Wild)</pre>
<ul>
  <li>Crossing below the flip -> Danger zone: reduce position sizes, expect wider price swings, or buy protective puts.</li>
  <li>Crossing above the flip -> Safety zone: expect steady, grinding upward movement with low volatility.</li>
</ul>

</div>
</details>

<details class="collapsible">
<summary><h2 class="sum-h">Delta Map — Walkthrough</h2></summary>
<div class="box-inner">
<ul>
{% for p in walkthrough %}<li>{{ p }}</li>{% endfor %}
</ul>

</div>
</details>
</div>
</details>

<div class="footer">{{ footer }}</div>
</div>
<script>
/* A printout shows every section: the collapsed ones open for it and go back afterwards. */
(function(){
  var closed = [];
  window.addEventListener('beforeprint', function(){
    closed = Array.prototype.filter.call(document.querySelectorAll('details.collapsible'), function(d){ return !d.open; });
    closed.forEach(function(d){ d.open = true; });
  });
  window.addEventListener('afterprint', function(){ closed.forEach(function(d){ d.open = false; }); closed = []; });
})();
/* One tooltip open at a time; a tap elsewhere or Escape closes it. */
(function(){
  var tips = document.querySelectorAll('details.tip');
  tips.forEach(function(d){ d.addEventListener('toggle', function(){
    if(d.open) tips.forEach(function(o){ if(o !== d) o.open = false; });
  }); });
  // A mouse hovers: the card opens its tooltip and closing follows the pointer, unless a click pinned it. A touch
  // screen has no hover, so there a tap is the only way (and the native <details> toggle).
  if(window.matchMedia && matchMedia('(hover: hover) and (pointer: fine)').matches){
    tips.forEach(function(d){
      var card = d.closest('.ag-gex'), s = d.querySelector('summary');
      card.addEventListener('mouseenter', function(){ d.open = true; });
      card.addEventListener('mouseleave', function(){ if(!d._pinned) d.open = false; });
      s.addEventListener('click', function(e){ e.preventDefault(); d._pinned = !d._pinned; d.open = d._pinned; });
    });
  }
  document.addEventListener('click', function(e){ tips.forEach(function(d){ if(d.open && !d.contains(e.target) && !d._pinned) d.open = false; }); });
  document.addEventListener('keydown', function(e){
    if(e.key !== 'Escape') return;
    tips.forEach(function(d){ if(d.open){ d._pinned = false; d.open = false; var s = d.querySelector('summary'); if(s) s.focus(); } });
  });
})();
/* A Plotly figure reserves a 220-250 px right margin; on a phone that margin is the whole chart. Below 520 px the
   margin shrinks, and it comes back when the window grows. */
(function(){
  function adapt(gd){
    if(!gd || !gd.layout || !window.Plotly) return;
    var narrow = gd.clientWidth < 520;
    if(gd._rcNarrow === narrow) return;
    if(!gd._rcOrig) gd._rcOrig = {r: gd.layout.margin.r, l: gd.layout.margin.l, h: gd._fullLayout.height,
      title: (gd.layout.title && gd.layout.title.font && gd.layout.title.font.size) || 16,
      ann: (gd.layout.annotations || []).map(function(a){ return {x: a.x, xanchor: a.xanchor, xshift: a.xshift, xref: a.xref, fs: (a.font && a.font.size) || 11, text: a.text}; })};
    gd._rcNarrow = narrow;
    var u = {'title.font.size': narrow ? Math.min(gd._rcOrig.title, 12) : gd._rcOrig.title, 'margin.r': narrow ? 16 : gd._rcOrig.r, 'margin.l': narrow ? Math.min(gd._rcOrig.l, 48) : gd._rcOrig.l};
    // The level labels sit in the right margin (xref paper, left-anchored): with the margin gone they move inside
    // the plot, right-aligned.
    (gd.layout.annotations || []).forEach(function(a, i){
      var o = gd._rcOrig.ann[i];
      if(!o || o.xref !== 'paper' || typeof o.x !== 'number' || o.x < 1 || o.xanchor !== 'left') return;
      u['annotations[' + i + '].x'] = narrow ? 1 : o.x;
      u['annotations[' + i + '].xanchor'] = narrow ? 'right' : o.xanchor;
      u['annotations[' + i + '].xshift'] = narrow ? -4 : (o.xshift || 0);
    });
    // Only the position map follows the screen's height, and only on a phone.
    if(gd.closest('.chart-map')){
      u.autosize = true;   // a height given to relayout would otherwise switch autosize off
      u.height = narrow ? Math.min(gd._rcOrig.h, Math.round(window.innerHeight * 0.7)) : gd._rcOrig.h;
      gd.style.height = u.height + 'px';
      if(gd.parentNode.style.height) gd.parentNode.style.height = u.height + 'px';   // Plotly's own wrapper carries the height too
    }
    (gd.layout.annotations || []).forEach(function(a, i){
      var o = gd._rcOrig.ann[i];
      if(!o) return;
      if(!narrow) u['annotations[' + i + '].font.size'] = o.fs;            // back to its own size when the window grows
      // A footer made of spans separated by two spaces (the tornado's legend) takes one line per part on a phone.
      if(typeof o.text === 'string' && /  <span/.test(o.text)) u['annotations[' + i + '].text'] = narrow ? o.text.replace(/  (?=<span)/g, '<br>') : o.text;
    });
    var done = Plotly.relayout(gd, u);
    // A label wider than the chart (the tornado's footer) shrinks to fit.
    if(narrow && done && done.then) done.then(function(){
      var s = gd.querySelector('.main-svg').getBoundingClientRect(), v = {};
      gd.querySelectorAll('g.annotation').forEach(function(g){
        var i = +g.getAttribute('data-index'), r = g.getBoundingClientRect(), o = gd._rcOrig.ann[i];
        if(!o || !r.width || (r.left >= s.left + 4 && r.right <= s.right - 4)) return;
        var mid = (r.left + r.right) / 2, room = 2 * Math.min(mid - s.left, s.right - mid) - 8;     // centred text
        v['annotations[' + i + '].font.size'] = Math.max(8, Math.floor(o.fs * Math.max(room, 40) / r.width));
      });
      if(Object.keys(v).length) Plotly.relayout(gd, v);
    });
  }
  function all(){ document.querySelectorAll('.js-plotly-plot').forEach(adapt); }
  window.addEventListener('load', function(){ setTimeout(all, 50); });
  window.addEventListener('resize', function(){ setTimeout(all, 150); });
})();
</script>
</body>
</html>
