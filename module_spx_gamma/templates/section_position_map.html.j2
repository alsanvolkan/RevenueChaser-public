  </tbody>
</table>
<div class="note">{{ scenarios.note }}</div>
{% if flow_signal %}
<div class="box" style="margin-top:14px">
  <div class="ag-label">Volume &amp; Flow Confluence Analysis</div>
  <div class="at-glance" style="margin:8px 0 0"><span class="flow-badge {{ 'flow-' + flow_signal.tone }}">{{ flow_signal.label }}</span> <span style="color:var(--fg)">{{ flow_signal.narrative }}</span></div>
</div>
{% endif %}

<h2>Level Migration vs Prior Snapshot</h2>
<table class="stack">
  <thead><tr><th>Level</th><th>This Week</th><th>Previous</th><th>Δ</th></tr></thead>
  <tbody>
  {% for m in migration %}
  <tr><td data-label="Level">{{ m.level }}</td><td data-label="This Week">{{ m.now | fmtnum }}</td>
    <td data-label="Previous">{{ m.prev | fmtnum }}</td>
    <td data-label="Δ">{{ m.delta | fmtnum('{:+,.1f}') }}</td></tr>
  {% endfor %}
  </tbody>
</table>

<h2>Top-10 GEX Strikes</h2>
<table class="stack">
  <thead><tr><th>#</th><th>Strike</th><th>Net GEX</th><th>Gamma-Flip Side</th></tr></thead>
  <tbody>
  {% for t in top_gex %}
  <tr><td data-label="#">{{ loop.index }}</td><td data-label="Strike">{{ t.strike|round|int }}</td>
    <td data-label="Net GEX" class="pos-neg {{ 'pos' if t.net_gex >= 0 else 'neg' }}">{{ t.net_gex | fmtnum('{:+,.1f}') }}</td>
    <td data-label="Gamma-Flip Side">{{ t.side }}</td></tr>
  {% endfor %}
  </tbody>
</table>

<h2>Expiry Distribution</h2>
<table class="stack">
  <thead><tr><th>Expiry</th><th>DTE</th><th>Band</th><th>Net GEX</th><th>Net DEX</th></tr></thead>
  <tbody>
  {% for e in summary_expiry %}
  <tr><td data-label="Expiry">{{ e.expiry }}</td><td data-label="DTE">{{ e.dte }}</td><td data-label="Band">{{ e.band }}</td>
    <td data-label="Net GEX">{{ e.net_gex }}</td><td data-label="Net DEX">{{ e.net_dex }}</td></tr>
  {% endfor %}
  </tbody>
</table>

<h2>Brier Scorecard</h2>
<div class="at-glance">
  <span class="muted">Scored weeks:</span> {{ brier.scored_count }}
  &middot; <span class="muted">Avg Brier:</span> {{ brier.average if brier.average is not none else "—" }}
  &middot; <span class="muted">Equal-weight ref:</span> {{ ("%.4f"|format(brier.equal_weight_reference)) if brier.equal_weight_reference is number else brier.equal_weight_reference }}
  {%- if brier.skill_score is number %}
  &middot; <span class="muted">Skill score:</span> {{ "%+.2f"|format(brier.skill_score) }}
  {%- endif %}
</div>
<div class="note">{{ brier.verdict }}</div>

<details class="collapsible">
<summary><h2 class="sum-h">Details</h2></summary>
<div class="box-inner">
<table class="stack">
  <thead><tr><th>Level</th><th>Value</th><th>Reference Type</th><th>Method / Disclosure</th></tr></thead>
  <tbody>
  {% for row in details %}<tr><td data-label="Level">{{ row.level }}</td><td data-label="Value">{{ row.value }}</td><td data-label="Reference Type">{{ row.ref }}</td><td data-label="Method / Disclosure">{{ row.method }}</td></tr>
  {% endfor %}
  </tbody>
</table>

</div>
</details>

<details class="collapsible">
<summary><h2 class="sum-h">How to read this map (Gamma)</h2></summary>
<div class="box-inner">
<ul>
  <li>Call Wall ({{ how_to_read.call_wall }}): magnetic ceiling — dealers may sell into rallies (take-profit zone).</li>
  <li>Put Wall ({{ how_to_read.put_wall }}): trampoline floor — dealers may buy into dips (bounce zone).</li>
</ul>
<p>Gamma Flip ({{ how_to_read.flip }}) — the volatility turning point:</p>
<pre>[ ABOVE FLIP LEVEL ]  ->  Positive Gamma Zone  ->  Volatility Suppressed (Calm)
------------------------------------------------------------------------------
[ GAMMA FLIP LEVEL ]  ->  The Volatility Turning Point
------------------------------------------------------------------------------
[ BELOW FLIP LEVEL ]  ->  Negative Gamma Zone  ->  Volatility Accelerated (Wild)</pre>
<ul>
  <li>Crossing below the flip -> Danger zone: reduce position sizes, expect wider price swings, or buy protective puts.</li>
  <li>Crossing above the flip -> Safety zone: expect steady, grinding upward movement with low volatility.</li>
</ul>

</div>
</details>

<details class="collapsible">
<summary><h2 class="sum-h">Delta Map — Walkthrough</h2></summary>
<div class="box-inner">
<ul>
{% for p in walkthrough %}<li>{{ p }}</li>{% endfor %}
</ul>

</div>
</details>

<details class="collapsible">
<summary><h2 class="sum-h">Greek Sözlüğü &amp; İlişkiler — Türkçe</h2></summary>
<div class="box-inner tr-block">
  <div class="note">Aşağıdaki tanımlar ve ilişkiler eğitim amaçlıdır; bu raporun İngilizce başlıklarıyla aynı veriden türetilmiştir. Teknik sözlük:</div>
  <dl class="tr-glossary">
    {% for g in glossary_tr %}<dt>{{ g.greek }}</dt><dd>{{ g.def }}</dd>{% endfor %}
  </dl>
  <div class="note" style="margin-top:14px">Bu haftaki veriye göre greek ilişkileri:</div>
  {% for r in relations %}
  <div style="margin-top:10px">
    <b class="tr-name">{{ r.greek }}</b> — <span style="color:var(--muted)">{{ r.turkish }}</span>
  </div>
  {% endfor %}
</div>
</details>

<div class="footer">{{ footer }}</div>
<script>
/* A printout shows every section: the collapsed ones open for it and go back afterwards. */
(function(){
  var closed = [];
  window.addEventListener('beforeprint', function(){
    closed = Array.prototype.filter.call(document.querySelectorAll('details.collapsible'), function(d){ return !d.open; });
    closed.forEach(function(d){ d.open = true; });
  });
  window.addEventListener('afterprint', function(){ closed.forEach(function(d){ d.open = false; }); closed = []; });
})();
/* One tooltip open at a time; a tap elsewhere or Escape closes it. */
(function(){
  var tips = document.querySelectorAll('details.tip');
  tips.forEach(function(d){ d.addEventListener('toggle', function(){
    if(d.open) tips.forEach(function(o){ if(o !== d) o.open = false; });
  }); });
  document.addEventListener('click', function(e){ tips.forEach(function(d){ if(d.open && !d.contains(e.target)) d.open = false; }); });
  document.addEventListener('keydown', function(e){
    if(e.key !== 'Escape') return;
    tips.forEach(function(d){ if(d.open){ d.open = false; var s = d.querySelector('summary'); if(s) s.focus(); } });
  });
})();
/* A Plotly figure reserves a 220-250 px right margin; on a phone that margin is the whole chart. Below 520 px the
   margin shrinks, and it comes back when the window grows. */
(function(){
  function adapt(gd){
    if(!gd || !gd.layout || !window.Plotly) return;
    var narrow = gd.clientWidth < 520;
    if(gd._rcNarrow === narrow) return;
    if(!gd._rcOrig) gd._rcOrig = {r: gd.layout.margin.r, l: gd.layout.margin.l, h: gd._fullLayout.height,
      ann: (gd.layout.annotations || []).map(function(a){ return {x: a.x, xanchor: a.xanchor, xshift: a.xshift, xref: a.xref, fs: (a.font && a.font.size) || 11, text: a.text}; })};
    gd._rcNarrow = narrow;
    var u = {'margin.r': narrow ? 16 : gd._rcOrig.r, 'margin.l': narrow ? Math.min(gd._rcOrig.l, 48) : gd._rcOrig.l};
    // The level labels sit in the right margin (xref paper, left-anchored): with the margin gone they move inside
    // the plot, right-aligned.
    (gd.layout.annotations || []).forEach(function(a, i){
      var o = gd._rcOrig.ann[i];
      if(!o || o.xref !== 'paper' || typeof o.x !== 'number' || o.x < 1 || o.xanchor !== 'left') return;
      u['annotations[' + i + '].x'] = narrow ? 1 : o.x;
      u['annotations[' + i + '].xanchor'] = narrow ? 'right' : o.xanchor;
      u['annotations[' + i + '].xshift'] = narrow ? -4 : (o.xshift || 0);
    });
    // Only the position map follows the screen's height, and only on a phone.
    if(gd.closest('.chart-map')){
      u.autosize = true;   // a height given to relayout would otherwise switch autosize off
      u.height = narrow ? Math.min(gd._rcOrig.h, Math.round(window.innerHeight * 0.7)) : gd._rcOrig.h;
      gd.style.height = u.height + 'px';
      if(gd.parentNode.style.height) gd.parentNode.style.height = u.height + 'px';   // Plotly's own wrapper carries the height too
    }
    (gd.layout.annotations || []).forEach(function(a, i){
      var o = gd._rcOrig.ann[i];
      if(!o) return;
      if(!narrow) u['annotations[' + i + '].font.size'] = o.fs;            // back to its own size when the window grows
      // A footer made of spans separated by two spaces (the tornado's legend) takes one line per part on a phone.
      if(typeof o.text === 'string' && /  <span/.test(o.text)) u['annotations[' + i + '].text'] = narrow ? o.text.replace(/  (?=<span)/g, '<br>') : o.text;
    });
    var done = Plotly.relayout(gd, u);
    // A label wider than the chart (the tornado's footer) shrinks to fit.
    if(narrow && done && done.then) done.then(function(){
      var s = gd.querySelector('.main-svg').getBoundingClientRect(), v = {};
      gd.querySelectorAll('g.annotation').forEach(function(g){
        var i = +g.getAttribute('data-index'), r = g.getBoundingClientRect(), o = gd._rcOrig.ann[i];
        if(!o || !r.width || (r.left >= s.left + 4 && r.right <= s.right - 4)) return;
        var mid = (r.left + r.right) / 2, room = 2 * Math.min(mid - s.left, s.right - mid) - 8;     // centred text
        v['annotations[' + i + '].font.size'] = Math.max(8, Math.floor(o.fs * Math.max(room, 40) / r.width));
      });
      if(Object.keys(v).length) Plotly.relayout(gd, v);
    });
  }
  function all(){ document.querySelectorAll('.js-plotly-plot').forEach(adapt); }
  window.addEventListener('load', function(){ setTimeout(all, 50); });
  window.addEventListener('resize', function(){ setTimeout(all, 150); });
})();
</script>
</body>
</html>
