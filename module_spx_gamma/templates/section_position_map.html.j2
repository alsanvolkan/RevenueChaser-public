  {% if vix %}<tr><td data-label="Metric">VIX family</td><td data-label="Value">
    {% if vix.vix %}VIX {{ vix.vix|round(2) }}{% endif %}{% if vix.vix9d %} · 9D {{ vix.vix9d|round(2) }}{% endif %}{% if vix.vix3m %} · 3M {{ vix.vix3m|round(2) }}{% endif %}{% if vix.vix6m %} · 6M {{ vix.vix6m|round(2) }}{% endif %}{% if vix.vix1y %} · 1Y {{ vix.vix1y|round(2) }}{% endif %}{% if vix.vvix %} · VVIX {{ vix.vvix|round(2) }}{% endif %}
    </td><td data-label="Meaning">Term structure is <b>{{ vix.term_mode or "n/a" }}</b>{% if vix.ivts %} (IVTS {{ vix.ivts|round(4) }}){% endif %}{% if vix.term_mode == 'contango' %} — short-dated calm, longer-dated more expensive (normal).{% elif vix.term_mode == 'backwardation' %} — near-term stress priced in (early warning).{% elif vix.term_mode == 'front backwardation' %} — the next 9 days priced above the month while the 3M curve still slopes up (first sign of near-term stress).{% endif %}</td></tr>{% endif %}
  {% if straddle %}<tr><td data-label="Metric">Straddle expected move</td><td data-label="Value">{% if historical.straddle %}n/a (historical){% else %}±{{ straddle.points | fmtnum('{:,.1f}') }} ({{ straddle.lower | fmtnum('{:,.0f}') }} – {{ straddle.upper | fmtnum('{:,.0f}') }}){% endif %}</td><td data-label="Meaning">The {{ straddle.expiry }} at-the-money straddle at {{ straddle.strike | fmtnum('{:,.0f}') }} (UW quotes): the market's own expected move to that expiry, beside the 1-sd move.</td></tr>{% endif %}
  {% if vega_flow %}<tr><td data-label="Metric">Directional vega flow</td><td data-label="Value">{{ vega_flow.dir_vega_flow | fmtnum('{:+,.0f}') }}{% if vega_flow.buckets %} ({{ vega_flow.buckets }} buckets){% endif %}{% if vega_flow.get('verdict') %} · <b>{{ vega_flow.verdict }}</b>{% endif %}</td><td data-label="Meaning">Vega that changed hands today, cumulative. Its <b>sign</b> is the reading, not its size — and this is flow, not the net vega sitting in the book.</td></tr>{% endif %}
  {% if vix_greeks %}<tr><td data-label="Metric">VIX option book</td><td data-label="Value">net vanna {{ vix_greeks.net_vanna | fmtnum('{:+,.0f}') }} · net charm {{ vix_greeks.net_charm | fmtnum('{:+,.0f}') }}{% if vix_greeks.expiries %} ({{ vix_greeks.expiries }} expiries){% endif %}</td><td data-label="Meaning">VIX's own dealer book. Only its vanna and charm are published by this provider, so its gamma levels are not shown.</td></tr>{% endif %}
  {% if iv_rank %}<tr><td data-label="Metric">IV Rank (1Y)</td><td data-label="Value">{{ "n/a (historical)" if historical.iv_rank else (iv_rank.iv_rank_1y | fmtnum('{:,.1f}%')) }}</td><td data-label="Meaning">Where today's IV sits vs the past year; low = cheap options.</td></tr>{% endif %}
  {% if skew %}<tr><td data-label="Metric">Skew (25Δ put − call IV)</td><td data-label="Value">{% if historical.skew %}n/a (historical){% else %}{{ skew.get('put_bias_0dte') | fmtnum('{:.1%}') }} (0DTE) · {{ skew.put_bias_1m | fmtnum('{:.1%}') }} (1M) · {{ skew.put_bias_3m | fmtnum('{:.1%}') }} (3M){% endif %}</td><td data-label="Meaning">Cost of downside protection vs upside bets. {{ skew.note }}</td></tr>{% endif %}
  {% if realized_vol %}<tr><td data-label="Metric">Realized vs Implied</td><td data-label="Value">{% if historical.realized_vol %}n/a (historical){% else %}IV {{ realized_vol.implied_volatility | fmtnum('{:.1%}') }} · RV {{ realized_vol.realized_volatility | fmtnum('{:.1%}') }}{% endif %}</td><td data-label="Meaning">VRP posture: IV premium over realized = vol selling gets paid.</td></tr>{% endif %}
  {% if vrp %}<tr><td data-label="Metric">Variance Risk Premium</td><td data-label="Value">{% if historical.vrp %}n/a (historical){% else %}{{ vrp.risk_premium | fmtnum('{:.2%}') }} (rank {{ vrp.rank | fmtnum('{:,.2f}') }}){% endif %}</td><td data-label="Meaning">Compensation for holding short vol; higher = richer sellers.</td></tr>{% endif %}
  </tbody>
</table>
