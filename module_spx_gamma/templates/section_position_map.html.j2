{% elif chart_image %}<div class="chart"><img src="{{ chart_image }}" alt="SPX Option Position Map"></div>{% endif %}</div>{% if store_labels.candles %}
<div class="note store-source">{{ store_labels.candles }}</div>{% endif %}

<h2>Net GEX Tornado — Strike Profile</h2>
<div class="box">{% if tornado_html %}<div class="chart">{{ tornado_html }}</div>{% else %}<div class="box-note">Tornado data unavailable for this snapshot.</div>{% endif %}</div>

<h2>Liquidity Layer — Dealer Flow</h2>
